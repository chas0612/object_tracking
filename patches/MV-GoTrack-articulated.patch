+#!/usr/bin/env python3
+"""Recover a known body pose and joint angle from anchors that have been corrupted.
+
+The articulated fit is the one piece of the articulated tracker that can be checked
+without a GPU, a renderer, or a capture: build anchors from a pose and an angle that
+are known exactly, damage them the way the real pipeline will, and see what comes
+back. Everything downstream inherits whatever this gets wrong, so it is worth
+testing on its own before any of it exists.
+
+Run: python tests/test_articulated_fit.py
+"""
+
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from utils.multiview_geometry import (  # noqa: E402
+    compute_articulated_fit_residuals,
+    fit_articulated_transform_weighted,
+    fit_joint_angle_weighted,
+    joint_transform,
+    reject_wrong_surface_anchors,
+    robust_fit_articulated_pose_from_anchors,
+)
+
+# Roughly the blue box: a 180 x 140 x 120 mm body, hinged along its top rear edge,
+# with the lid extending forward from that hinge. Metres, matching the capture.
+AXIS = np.array([1.0, 0.0, 0.0])
+ORIGIN = np.array([0.0, 0.07, 0.06])
+FAILURES: list[str] = []
+
+
+def _random_pose(rng: np.random.Generator) -> np.ndarray:
+    axis = rng.normal(size=3)
+    axis /= np.linalg.norm(axis)
+    angle = rng.uniform(0.0, np.pi)
+    cross = np.array([[0.0, -axis[2], axis[1]],
+                      [axis[2], 0.0, -axis[0]],
+                      [-axis[1], axis[0], 0.0]])
+    pose = np.eye(4)
+    pose[:3, :3] = (np.eye(3) + np.sin(angle) * cross
+                    + (1.0 - np.cos(angle)) * (cross @ cross))
+    pose[:3, 3] = rng.uniform(-0.5, 0.5, size=3)
+    return pose
+
+
+def _anchors(rng: np.random.Generator, n_body: int = 120, n_lid: int = 80):
+    body = np.column_stack([rng.uniform(-0.09, 0.09, n_body),
+                            rng.uniform(-0.07, 0.07, n_body),
+                            rng.uniform(-0.06, 0.06, n_body)])
+    # The lid hangs off the hinge, so its anchors have a real lever arm about the
+    # axis -- anchors sitting on the axis carry no angle information at all.
+    lid = np.column_stack([rng.uniform(-0.09, 0.09, n_lid),
+                           rng.uniform(0.07, 0.21, n_lid),
+                           rng.uniform(0.055, 0.065, n_lid)])
+    source = np.vstack([body, lid])
+    parts = np.concatenate([np.zeros(n_body, dtype=int), np.ones(n_lid, dtype=int)])
+    return source, parts
+
+
+def _observe(source, parts, pose, theta):
+    posed = source.copy()
+    moving = parts == 1
+    transform = joint_transform(AXIS, ORIGIN, theta)
+    posed[moving] = source[moving] @ transform[:3, :3].T + transform[:3, 3]
+    return posed @ pose[:3, :3].T + pose[:3, 3]
+
+
+def _check(name: str, condition: bool, detail: str = "") -> None:
+    print(f"  {'PASS' if condition else 'FAIL'}  {name}{'  ' + detail if detail else ''}")
+    if not condition:
+        FAILURES.append(name)
+
+
+def test_exact() -> None:
+    """No noise: the answer should come back to numerical precision."""
+    print("\nexact anchors")
+    rng = np.random.default_rng(0)
+    for theta_true_deg in (0.0, 47.4, 163.6, 215.0):
+        pose_true = _random_pose(rng)
+        source, parts = _anchors(rng)
+        target = _observe(source, parts, pose_true, np.radians(theta_true_deg))
+        pose, theta, rounds = fit_articulated_transform_weighted(
+            source, target, np.ones(len(source)), parts, AXIS, ORIGIN)
+        angle_error = np.degrees(abs(np.arctan2(
+            np.sin(theta - np.radians(theta_true_deg)),
+            np.cos(theta - np.radians(theta_true_deg)))))
+        shift = np.linalg.norm(pose[:3, 3] - pose_true[:3, 3]) * 1000.0
+        _check(f"theta {theta_true_deg:6.1f} deg recovered", angle_error < 1.0e-3,
+               f"err {angle_error:.2e} deg, {shift:.2e} mm, {rounds} rounds")
+
+
+def test_theta_from_body_frame() -> None:
+    """The one-dimensional solve, isolated from the pose."""
+    print("\njoint angle alone, body frame")
+    rng = np.random.default_rng(1)
+    source, parts = _anchors(rng)
+    lid = source[parts == 1]
+    for theta_true_deg in (-30.0, 0.0, 90.0, 215.0):
+        transform = joint_transform(AXIS, ORIGIN, np.radians(theta_true_deg))
+        target = lid @ transform[:3, :3].T + transform[:3, 3]
+        theta = fit_joint_angle_weighted(lid, target, np.ones(len(lid)), AXIS, ORIGIN)
+        error = np.degrees(abs(np.arctan2(np.sin(theta - np.radians(theta_true_deg)),
+                                          np.cos(theta - np.radians(theta_true_deg)))))
+        _check(f"theta {theta_true_deg:6.1f} deg", error < 1.0e-6, f"err {error:.2e} deg")
+
+
+def test_noise() -> None:
+    """Anchor noise at the scale triangulation actually delivers."""
+    print("\nGaussian anchor noise")
+    for sigma_mm in (1.0, 3.0, 10.0):
+        errors, shifts = [], []
+        for trial in range(20):
+            rng = np.random.default_rng(100 + trial)
+            pose_true = _random_pose(rng)
+            theta_true = np.radians(rng.uniform(0.0, 215.0))
+            source, parts = _anchors(rng)
+            target = _observe(source, parts, pose_true, theta_true)
+            target = target + rng.normal(scale=sigma_mm / 1000.0, size=target.shape)
+            pose, theta, _ = fit_articulated_transform_weighted(
+                source, target, np.ones(len(source)), parts, AXIS, ORIGIN)
+            errors.append(np.degrees(abs(np.arctan2(np.sin(theta - theta_true),
+                                                    np.cos(theta - theta_true)))))
+            shifts.append(np.linalg.norm(pose[:3, 3] - pose_true[:3, 3]) * 1000.0)
+        _check(f"sigma {sigma_mm:4.1f} mm", float(np.median(errors)) < sigma_mm * 0.5,
+               f"median theta err {np.median(errors):.2f} deg, "
+               f"median shift {np.median(shifts):.2f} mm")
+
+
+def test_outliers() -> None:
+    """Gross outliers, which the inlier refit is there to remove."""
+    print("\noutliers, 20 percent")
+    for trial in range(5):
+        rng = np.random.default_rng(200 + trial)
+        pose_true = _random_pose(rng)
+        theta_true = np.radians(rng.uniform(20.0, 200.0))
+        source, parts = _anchors(rng)
+        target = _observe(source, parts, pose_true, theta_true)
+        target = target + rng.normal(scale=0.002, size=target.shape)
+        corrupt = rng.choice(len(target), size=len(target) // 5, replace=False)
+        target[corrupt] += rng.normal(scale=0.08, size=(len(corrupt), 3))
+
+        result = robust_fit_articulated_pose_from_anchors(
+            source, target, np.ones(len(source)), parts, AXIS, ORIGIN,
+            inlier_threshold_mm=10.0)
+        error = np.degrees(abs(np.arctan2(np.sin(result["theta_rad"] - theta_true),
+                                          np.cos(result["theta_rad"] - theta_true))))
+        _check(f"trial {trial}", error < 2.0,
+               f"theta err {error:5.2f} deg, status {result['status']}, "
+               f"{result['num_inlier_anchors']}/{result['num_input_anchors']} inliers")
+
+
+def test_unobservable_theta() -> None:
+    """No anchors on the moving part: the angle must be held, not invented."""
+    print("\nmoving part invisible")
+    rng = np.random.default_rng(7)
+    pose_true = _random_pose(rng)
+    theta_true = np.radians(120.0)
+    source, parts = _anchors(rng)
+    keep = parts == 0
+    target = _observe(source, parts, pose_true, theta_true)
+
+    result = robust_fit_articulated_pose_from_anchors(
+        source[keep], target[keep], np.ones(int(keep.sum())), parts[keep], AXIS, ORIGIN,
+        inlier_threshold_mm=10.0, theta_init=theta_true)
+    shift = np.linalg.norm(result["pose_world_from_object"][:3, 3] - pose_true[:3, 3]) * 1000.0
+    _check("status reports theta unobserved", result["status"] == "theta_unobserved",
+           f"status {result['status']}, theta_observed={result['theta_observed']}")
+    _check("held angle is returned unchanged",
+           abs(result["theta_rad"] - theta_true) < 1.0e-9)
+    _check("body pose still recovered", shift < 1.0e-3, f"{shift:.2e} mm")
+
+
+def test_clamp_is_flagged() -> None:
+    """A binding limit censors the estimate, and that has to be visible."""
+    print("\njoint limit")
+    rng = np.random.default_rng(11)
+    pose_true = _random_pose(rng)
+    theta_true = np.radians(215.0)
+    source, parts = _anchors(rng)
+    target = _observe(source, parts, pose_true, theta_true)
+
+    loose = robust_fit_articulated_pose_from_anchors(
+        source, target, np.ones(len(source)), parts, AXIS, ORIGIN,
+        inlier_threshold_mm=10.0, theta_limits_rad=(0.0, np.radians(260.0)))
+    tight = robust_fit_articulated_pose_from_anchors(
+        source, target, np.ones(len(source)), parts, AXIS, ORIGIN,
+        inlier_threshold_mm=10.0, theta_limits_rad=(0.0, np.radians(205.8)))
+    _check("within limits, not flagged", not loose["theta_clamped"],
+           f"theta {loose['theta_deg']:.2f} deg")
+    _check("beyond limits, flagged", tight["theta_clamped"],
+           f"theta {tight['theta_deg']:.2f} deg, was {loose['theta_deg']:.2f}")
+
+
+def test_runaway_angle_is_rejected() -> None:
+    """A moving part that the angle cannot explain must not drag the body with it.
+
+    Reproduces the shape of the capture-6 failure: the body anchors are observed
+    where the true pose puts them, while the moving anchors are observed somewhere
+    a wrong angle would put them. Anchor counts stay healthy throughout, which is
+    why the count-based check cannot see it.
+    """
+    print("\nrunaway angle")
+    rng = np.random.default_rng(21)
+    pose_true = _random_pose(rng)
+    theta_true = np.radians(120.0)
+    source, parts = _anchors(rng)
+    moving = parts == 1
+
+    target = _observe(source, parts, pose_true, theta_true)
+    # What a lost lid looks like, and what it does not. Moving the whole lid to a
+    # different angle coherently is invisible here and always will be: the fit finds
+    # that angle and explains it perfectly, so no residual test can object. The
+    # detectable failure is the one that actually happened -- the flow stopped
+    # following the lid, and its triangulated anchors scattered into a cloud that no
+    # single rotation about the hinge can account for.
+    target[moving] += rng.normal(scale=0.05, size=(int(moving.sum()), 3))
+
+    result = robust_fit_articulated_pose_from_anchors(
+        source, target, np.ones(len(source)), parts, AXIS, ORIGIN,
+        inlier_threshold_mm=10.0, theta_init=theta_true, theta_reference_rad=theta_true)
+    shift = np.linalg.norm(
+        result["pose_world_from_object"][:3, 3] - pose_true[:3, 3]) * 1000.0
+    _check("rejection is reported", result["status"] == "theta_rejected"
+           and result["theta_rejected"] and not result["theta_observed"],
+           f"status {result['status']}, ratio {result['theta_residual_ratio']:.1f}")
+    _check("held angle is returned, not the runaway",
+           abs(result["theta_rad"] - theta_true) < 1.0e-9,
+           f"theta {result['theta_deg']:.1f} deg")
+    _check("body pose is not dragged", shift < 1.0, f"{shift:.3f} mm")
+    _check("anchor count alone would not have caught it",
+           int(result["num_moving_anchors"]) >= 80,
+           f"{result['num_moving_anchors']} moving anchors present")
+
+
+def test_healthy_frames_are_not_rejected() -> None:
+    """The gate must stay quiet on every frame that is merely noisy."""
+    print("\ngate stays quiet when the fit is good")
+    for sigma_mm in (1.0, 3.0, 10.0):
+        fired = 0
+        for trial in range(20):
+            rng = np.random.default_rng(300 + trial)
+            pose_true = _random_pose(rng)
+            theta_true = np.radians(rng.uniform(0.0, 215.0))
+            source, parts = _anchors(rng)
+            target = _observe(source, parts, pose_true, theta_true)
+            target = target + rng.normal(scale=sigma_mm / 1000.0, size=target.shape)
+            result = robust_fit_articulated_pose_from_anchors(
+                source, target, np.ones(len(source)), parts, AXIS, ORIGIN,
+                inlier_threshold_mm=10.0, theta_init=theta_true,
+                theta_reference_rad=theta_true)
+            fired += bool(result["theta_rejected"])
+        _check(f"sigma {sigma_mm:4.1f} mm: no false rejections", fired == 0,
+               f"{fired}/20 rejected")
+
+
+def test_residuals_are_per_part() -> None:
+    """A wrong angle must show up on the moving part and not on the static one."""
+    print("\nresiduals by part")
+    rng = np.random.default_rng(13)
+    pose_true = _random_pose(rng)
+    theta_true = np.radians(100.0)
+    source, parts = _anchors(rng)
+    target = _observe(source, parts, pose_true, theta_true)
+    residuals = compute_articulated_fit_residuals(
+        pose_true, theta_true + np.radians(10.0), source, target, parts, AXIS, ORIGIN)
+    _check("static part unaffected", float(np.max(residuals[parts == 0])) < 1.0e-6,
+           f"max {np.max(residuals[parts == 0]) * 1000.0:.2e} mm")
+    # Not the minimum: an anchor sitting on the hinge has no lever arm, so a wrong
+    # angle genuinely cannot move it. The median is what a 10 deg error should show.
+    _check("moving part shows the error", float(np.median(residuals[parts == 1])) > 0.005,
+           f"median {np.median(residuals[parts == 1]) * 1000.0:.1f} mm, "
+           f"min {np.min(residuals[parts == 1]) * 1000.0:.2f} mm")
+
+
+# A second, self-consistent geometry for the surface tests. The shared helpers
+# above put anchors anywhere inside the part's bounding box, which is fine when the
+# question is "does the fit recover the angle" and useless when it is "is this point
+# on this surface". These tests need anchors that lie on the same shells the test
+# measures against, and a hinge whose large angles are physically reachable: with the
+# lid hinged at the rear top edge it swings back and below the box, so at 215 deg it
+# is genuinely far from the body instead of passing through it.
+SHELL_AXIS = np.array([1.0, 0.0, 0.0])
+SHELL_ORIGIN = np.array([0.0, -0.07, 0.06])
+BODY_HALF = np.array([0.09, 0.07, 0.06])
+LID_Y = (-0.07, 0.09)
+LID_Z = 0.06
+
+
+def _box_shell(rng, half, n):
+    """Points on the surface of an axis-aligned box, area-weighted by face."""
+    areas = np.array([half[1] * half[2], half[0] * half[2], half[0] * half[1]])
+    axis_choice = rng.choice(3, size=n, p=areas / areas.sum())
+    points = rng.uniform(-half, half, size=(n, 3))
+    points[np.arange(n), axis_choice] = (
+        np.where(rng.random(n) < 0.5, -1.0, 1.0) * half[axis_choice])
+    return points
+
+
+def _lid_shell(rng, n):
+    """Points on a thin plate extending forward from the hinge."""
+    points = np.column_stack([
+        rng.uniform(-0.09, 0.09, n),
+        rng.uniform(LID_Y[0], LID_Y[1], n),
+        LID_Z + np.where(rng.random(n) < 0.5, -0.005, 0.005),
+    ])
+    return points
+
+
+def _shell_surfaces(n: int = 4000, seed: int = 5):
+    rng = np.random.default_rng(seed)
+    samples = np.vstack([_box_shell(rng, BODY_HALF, n), _lid_shell(rng, n)])
+    return samples.astype(np.float32), np.array([0, n, 2 * n], dtype=np.int64)
+
+
+def _shell_anchors(rng, n_body: int = 120, n_lid: int = 80):
+    source = np.vstack([_box_shell(rng, BODY_HALF, n_body), _lid_shell(rng, n_lid)])
+    parts = np.concatenate([np.zeros(n_body, dtype=int), np.ones(n_lid, dtype=int)])
+    return source, parts
+
+
+def _shell_observe(source, parts, pose, theta):
+    posed = source.copy()
+    moving = parts == 1
+    transform = joint_transform(SHELL_AXIS, SHELL_ORIGIN, theta)
+    posed[moving] = source[moving] @ transform[:3, :3].T + transform[:3, 3]
+    return posed @ pose[:3, :3].T + pose[:3, 3]
+
+
+def _migrate_onto_body(rng, target, parts, pose, samples, offsets, noise_m=0.004):
+    """Move every lid anchor onto the body surface, as the real failure does."""
+    moving = parts == 1
+    body = samples[offsets[0]:offsets[1]].astype(np.float64)
+    picked = body[rng.integers(0, body.shape[0], int(moving.sum()))]
+    picked = picked + rng.normal(scale=noise_m, size=picked.shape)
+    target[moving] = picked @ pose[:3, :3].T + pose[:3, 3]
+    return int(moving.sum())
+
+
+def _reject(source, target, parts, pose, theta, samples, offsets):
+    return reject_wrong_surface_anchors(
+        target, parts, source_points_o=source, pose_world_from_object=pose, theta=theta,
+        axis_o=SHELL_AXIS, origin_o=SHELL_ORIGIN, part_surface_samples_o=samples,
+        part_surface_offsets=offsets, margin_external=0.02 * 0.188)
+
+
+def test_migrated_anchors_are_rejected() -> None:
+    """Moving anchors that have latched onto the static part must be dropped.
+
+    This is the capture-6 failure reproduced: the lid's anchors do not scatter, they
+    land on the body and track it faithfully a few mm off its surface. Because they
+    agree with each other, no residual test can object -- which is why this one asks
+    a different question.
+    """
+    print("\nanchors migrated onto the other part")
+    rng = np.random.default_rng(21)
+    pose_true = _random_pose(rng)
+    theta_true = np.radians(215.0)
+    source, parts = _shell_anchors(rng)
+    target = _shell_observe(source, parts, pose_true, theta_true)
+    samples, offsets = _shell_surfaces()
+    num_moving = _migrate_onto_body(rng, target, parts, pose_true, samples, offsets)
+
+    result = _reject(source, target, parts, pose_true, theta_true, samples, offsets)
+    rejected_moving = int(result["num_rejected_by_part"][1])
+    _check("migrated moving anchors rejected", rejected_moving > 0.9 * num_moving,
+           f"{rejected_moving}/{num_moving} rejected")
+    _check("static anchors kept", int(result["num_rejected_by_part"][0]) == 0,
+           f"{int(result['num_rejected_by_part'][0])} static rejected")
+
+    keep = np.asarray(result["keep_mask"], dtype=bool)
+    fit = robust_fit_articulated_pose_from_anchors(
+        source_points_o=source[keep], target_points_w=target[keep],
+        weights=np.ones(int(keep.sum())), part_ids=parts[keep],
+        axis_o=SHELL_AXIS, origin_o=SHELL_ORIGIN, inlier_threshold_mm=28.0,
+        theta_init=theta_true, theta_reference_rad=theta_true)
+    shift = np.linalg.norm(fit["pose_world_from_object"][:3, 3] - pose_true[:3, 3])
+    _check("body pose uncontaminated after rejection", shift < 1.0e-5,
+           f"body shift {shift * 1000.0:.5f} mm, theta_observed={fit.get('theta_observed')}")
+
+
+def test_healthy_anchors_survive_surface_test() -> None:
+    """A well-tracked frame must not lose anchors it should have kept.
+
+    Silence is required at the noise the tracker actually runs at -- the measured fit
+    residual on healthy frames is 0.7-1.8 mm -- and only graceful degradation beyond
+    it. At 3 mm noise against surfaces 5 mm apart the question is genuinely
+    unanswerable: no rule can be both silent under that noise and decisive at that
+    separation, and pretending otherwise would only mean tuning the margin until this
+    particular test passed. A few percent of anchors lost on a pessimistic frame costs
+    nothing when 500 are triangulated and 3 are needed; missing a runaway costs the
+    rest of the sequence. So the asymmetry is deliberate.
+    """
+    print("\nhealthy frames keep their anchors")
+    rng = np.random.default_rng(22)
+    samples, offsets = _shell_surfaces()
+    for theta_deg in (0.0, 90.0, 215.0):
+        for noise_mm, tolerated in ((1.0, 0.0), (3.0, 0.05)):
+            pose_true = _random_pose(rng)
+            theta_true = np.radians(theta_deg)
+            source, parts = _shell_anchors(rng)
+            target = _shell_observe(source, parts, pose_true, theta_true)
+            target += rng.normal(scale=noise_mm / 1000.0, size=target.shape)
+            result = _reject(source, target, parts, pose_true, theta_true, samples, offsets)
+            rate = int(result["num_rejected"]) / float(target.shape[0])
+            _check(f"theta={theta_deg:.0f} deg, noise={noise_mm:.0f} mm "
+                   f"loses <={tolerated:.0%}", rate <= tolerated,
+                   f"{int(result['num_rejected'])}/{target.shape[0]} rejected "
+                   f"({rate:.1%}), {int(result['num_abstained'])} abstained")
+
+
+def test_surface_test_needs_no_reference_pose() -> None:
+    """The test must work off the stale pose the tracker actually has.
+
+    In the runtime the only estimate available is the previous frame's, and its angle
+    is the wrong one -- that is the situation being detected. What makes this work is
+    the measured asymmetry: the body stays accurate while the angle does not, so a
+    stale pose is still a usable reference for "which surface is this near".
+    """
+    print("\nrejection from a stale pose and a wrong angle")
+    rng = np.random.default_rng(23)
+    pose_true = _random_pose(rng)
+    source, parts = _shell_anchors(rng)
+    target = _shell_observe(source, parts, pose_true, np.radians(150.0))
+    samples, offsets = _shell_surfaces()
+    num_moving = _migrate_onto_body(rng, target, parts, pose_true, samples, offsets)
+
+    stale = pose_true.copy()
+    stale[:3, 3] += np.array([0.003, -0.002, 0.001])
+    result = _reject(source, target, parts, stale, np.radians(210.0), samples, offsets)
+    rejected_moving = int(result["num_rejected_by_part"][1])
+    _check("still rejects with a stale pose and wrong angle",
+           rejected_moving > 0.9 * num_moving,
+           f"{rejected_moving}/{num_moving} rejected")
+    _check("static anchors still kept", int(result["num_rejected_by_part"][0]) == 0,
+           f"{int(result['num_rejected_by_part'][0])} static rejected")
+
+
+if __name__ == "__main__":
