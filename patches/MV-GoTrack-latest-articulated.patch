@@ -0,0 +1,314 @@
+"""One-joint capture tracking with the compiled observer and articulated tri-fit.
+
+Rigid IRLS is deliberately not used for moving-part anchors. Public mesh,
+extrinsic, pose and prismatic coordinate units are metres; angles are radians.
+"""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from types import SimpleNamespace
+
+import numpy as np
+
+from evaluation.dexycb_tracking.adapters import GoTrackTrackingAdapter
+from multiview_solver.fusion_backends import (
+    AcceptancePolicy, FusionResult, fit_quality_score, is_rigid_pose)
+from utils.anchor_bank import (
+    articulation_from_anchor_bank, fuse_articulated_parts, load_anchor_bank,
+    prepare_anchor_bank_for_gotrack, sample_articulated_mesh_anchors, save_anchor_bank)
+from utils.anchor_tracking import pose_anchors_at_joint_angle
+from utils.multiview_geometry import (
+    build_fit_weights_from_triangulation_records, reject_wrong_surface_anchors,
+    robust_fit_articulated_pose_from_anchors, robust_fit_pose_from_anchors,
+    triangulate_anchor_observations, validate_joint_type)
+
+USABLE = {"ok", "no_inlier_refit", "theta_unobserved", "theta_rejected"}
+
+
+def load_joint_spec(path):
+    path = Path(path).resolve()
+    spec = json.loads(path.read_text())
+    if "joints" in spec:
+        if len(spec["joints"]) != 1:
+            raise ValueError("Exactly one joint is supported")
+        joint = dict(spec["joints"][0])
+        names = [spec["parts"][str(joint[k])] for k in ("parent", "child")]
+        paths = []
+        for name in names:
+            candidates = [path.parent / "parts" / name / f"{name}.obj",
+                          path.parent / "parts" / f"{name}.obj"]
+            found = next((p for p in candidates if p.is_file()), None)
+            if found is None:
+                raise FileNotFoundError(f"Cannot resolve joint part {name} near {path}")
+            paths.append(str(found))
+        joint.update(parts=paths, joint_type=joint.get("type", "revolute"), part_names=names)
+        if joint["joint_type"] == "prismatic":
+            joint["range"] = joint.get("range", joint.get("range_m"))
+        spec = joint
+    if "measured" in spec:
+        spec = {**spec["measured"], "parts": spec.get("parts") or spec["measured"].get("parts")}
+    parts = spec.get("parts") or ["body", "lid"]
+    if isinstance(parts, dict):
+        parts = [parts["0"], parts["1"]]
+    paths = []
+    for part in parts:
+        direct = path.parent / part
+        candidates = [direct, path.parent / "parts" / part / f"{part}.obj",
+                      path.parent / "parts" / f"{part}.obj"]
+        found = next((p for p in candidates if p.is_file()), None)
+        if found is None:
+            raise FileNotFoundError(f"Cannot resolve joint part {part} near {path}")
+        paths.append(str(found.resolve()))
+    spec["parts"] = paths
+    if len(spec["parts"]) != 2:
+        raise ValueError("Exactly two parts are required")
+    spec["joint_type"] = validate_joint_type(spec.get("type", spec.get("joint_type", "revolute")))
+    axis = np.asarray(spec["axis"], float).reshape(3)
+    if not np.isfinite(axis).all() or not np.isclose(np.linalg.norm(axis), 1, atol=1e-5):
+        raise ValueError("Joint axis must be a finite unit vector")
+    if not np.isfinite(np.asarray(spec.get("origin", [0, 0, 0]), float)).all():
+        raise ValueError("Joint origin must be finite")
+    if spec["joint_type"] == "prismatic" and spec.get("range_rad") is not None:
+        raise ValueError("Prismatic limits are lengths, not range_rad")
+    if spec["joint_type"] == "prismatic":
+        spec["range"] = spec.get("range", spec.get("range_m", spec.get("travel")))
+    elif spec.get("range_rad") is None and spec.get("range_deg") is not None:
+        spec["range_rad"] = np.radians(spec["range_deg"]).tolist()
+    limits = spec.get("range_rad" if spec["joint_type"] == "revolute" else "range")
+    if limits is not None and (np.asarray(limits).shape != (2,) or
+                              not np.isfinite(limits).all() or limits[0] > limits[1]):
+        raise ValueError("Joint limits must be two finite ordered values")
+    return spec
+
+
+class ArticulatedPolicy(AcceptancePolicy):
+    def decide(self, backend, result):
+        if result.fit_status in {"theta_unobserved", "theta_rejected"}:
+            if result.pose is not None and is_rigid_pose(result.pose):
+                return True, "accepted_body_joint_held"
+        return super().decide(backend, result)
+
+
+class ArticulatedBackend:
+    name = "triangulate"
+
+    def __init__(self, adapter):
+        self.adapter = adapter
+
+    def solve(self, frame, ctx):
+        owner = self.adapter
+        joint = owner.joint
+        tri = triangulate_anchor_observations(
+            observations_by_anchor=frame.observations_by_anchor,
+            intrinsics_map=frame.intrinsics_map, extrinsics_map=frame.extrinsics_map,
+            min_views=ctx.triangulation_min_views,
+            external_unit_scale_to_meter=ctx.external_unit_scale_to_meter,
+            weight_mode=ctx.triangulation_weight_mode, weight_alpha=ctx.triangulation_weight_alpha)
+        health = {"tri_status": tri.get("status")}
+        if tri.get("status") != "ok":
+            return FusionResult(None, str(tri.get("status")), 0, health)
+        rows = [r for r in tri["records"] if ctx.max_triangulation_residual_mm <= 0 or
+                r["triangulation_residual_mm"] <= ctx.max_triangulation_residual_mm]
+        if not rows:
+            return FusionResult(None, "all_filtered", 0, health)
+        source = np.asarray([r["position_o"] for r in rows])
+        target = np.asarray([r["position_w"] for r in rows])
+        ids = np.asarray([r["anchor_id"] for r in rows], dtype=np.int64)
+        parts = joint["part_ids"][ids]
+        weights = build_fit_weights_from_triangulation_records(
+            rows, mode=ctx.fit_weight_mode,
+            geometry_support_reference_views=ctx.geometry_fit_support_reference_views,
+            geometry_residual_tau_mm=ctx.geometry_fit_residual_tau_mm,
+            geometry_parallax_power=ctx.geometry_fit_parallax_power,
+            geometry_parallax_stat=ctx.geometry_fit_parallax_stat,
+            geometry_min_weight=ctx.geometry_fit_min_weight)
+        if owner.wrong_surface_margin > 0:
+            rejection = reject_wrong_surface_anchors(
+                target, parts, source_points_o=source, pose_world_from_object=frame.prior_T_wo,
+                theta=owner.predicted, axis_o=joint["joint_axis_o"], origin_o=joint["joint_origin_o"],
+                part_surface_samples_o=joint["part_surface_samples_o"],
+                part_surface_offsets=joint["part_surface_offsets"],
+                margin_external=owner.wrong_surface_margin, joint_type=joint["joint_type"])
+            keep = rejection["keep_mask"]
+            weights = weights * keep
+            health["wrong_surface_rejected"] = rejection["num_rejected"]
+        if owner.pinned:
+            posed = pose_anchors_at_joint_angle(
+                source, parts, joint["joint_axis_o"], joint["joint_origin_o"], owner.predicted,
+                joint_type=joint["joint_type"])
+            fit = robust_fit_pose_from_anchors(
+                posed, target, weights, inlier_threshold_mm=ctx.anchor_fit_inlier_mm,
+                min_anchors=ctx.anchor_fit_min_anchors,
+                external_unit_scale_to_meter=ctx.external_unit_scale_to_meter)
+            fit.update(joint_value=owner.predicted, joint_type=joint["joint_type"],
+                       theta_observed=True, theta_clamped=False, theta_rejected=False,
+                       joint_source="external_anchor")
+        else:
+            fit = robust_fit_articulated_pose_from_anchors(
+                source, target, weights, parts, joint["joint_axis_o"], joint["joint_origin_o"],
+                inlier_threshold_mm=ctx.anchor_fit_inlier_mm, min_anchors=ctx.anchor_fit_min_anchors,
+                min_moving_anchors=owner.min_moving_anchors,
+                external_unit_scale_to_meter=ctx.external_unit_scale_to_meter,
+                theta_init=owner.predicted,
+                theta_reference_rad=(owner.coordinate if joint["joint_type"] == "revolute" else None),
+                theta_limits_rad=joint["theta_limits_rad"], joint_type=joint["joint_type"],
+                joint_limits=(joint["joint_limits"] if joint["joint_type"] == "prismatic" else None),
+                theta_residual_ratio=owner.residual_ratio)
+        status = str(fit.get("status"))
+        health.update({k: v for k, v in fit.items() if k not in (
+            "pose_world_from_object", "inlier_mask", "residuals", "residuals_mm")})
+        health["num_triangulated"] = len(rows)
+        if status not in USABLE or "pose_world_from_object" not in fit:
+            return FusionResult(None, status, 0, health)
+        score = fit_quality_score(fit, ctx.anchor_fit_inlier_mm)
+        return FusionResult(fit["pose_world_from_object"], status, score, health, "articulated_triangulation")
+
+
+class ArticulatedGoTrackTrackingAdapter(GoTrackTrackingAdapter):
+    def __init__(self, config):
+        cfg = dict(config)
+        if cfg.get("fusion_backend") != "triangulate":
+            raise ValueError("Articulated tracking requires tri-fit; rigid IRLS cannot solve a joint")
+        self.spec = load_joint_spec(cfg["articulation_json"])
+        self.articulated_anchors = int(cfg.get("articulated_num_anchors", 512))
+        if self.articulated_anchors < 6:
+            raise ValueError("At least six articulated anchors are required")
+        self.initial_coordinate = float(cfg.get("init_joint_value", 0))
+        if not np.isfinite(self.initial_coordinate):
+            raise ValueError("Initial joint coordinate must be finite")
+        limits = self.spec.get("range_rad" if self.spec["joint_type"] == "revolute" else "range")
+        if limits is not None and not limits[0] <= self.initial_coordinate <= limits[1]:
+            raise ValueError("Initial joint coordinate is outside the joint limits")
+        self.extrapolate_max = float(cfg.get("joint_extrapolate_max", 0))
+        if self.extrapolate_max < 0:
+            raise ValueError("Joint extrapolation cap must be non-negative")
+        self.min_moving_anchors = int(cfg.get("min_moving_anchors", 3))
+        self.residual_ratio = float(cfg.get("theta_residual_ratio", 3))
+        self.wrong_surface_margin = float(cfg.get("wrong_surface_margin", .02))
+        self.anchor_bank_path = cfg.get("articulated_anchor_bank_path")
+        self.external_anchors = {int(k): float(v) for k, v in cfg.get("joint_anchors", {}).items()}
+        if any(not np.isfinite(v) or (limits is not None and not limits[0] <= v <= limits[1])
+               for v in self.external_anchors.values()):
+            raise ValueError("External joint anchors must be finite and within the joint limits")
+        self.current_frame = 0
+        # The rigid parent initializer's bank is replaced below; its constraint
+        # stays untouched for ordinary trackers.
+        cfg["anchor_bank_size"] = 256
+        super().__init__(cfg)
+        self._policy = ArticulatedPolicy.from_config(cfg)
+        self.reset()
+
+    def reset(self):
+        super().reset()
+        self.coordinate = self.initial_coordinate
+        self.predicted = self.coordinate
+        self.history = []
+        self.pinned = False
+
+    def initialize(self, object_id, mesh_path, K, T_c_w):
+        super().initialize(object_id, mesh_path, K, T_c_w)
+        spec = self.spec
+        kind = spec["joint_type"]
+        limits = {"joint_limits": spec.get("range", spec.get("travel"))} if kind == "prismatic" else {
+            "theta_limits_rad": spec.get("range_rad")}
+        if self.anchor_bank_path and Path(self.anchor_bank_path).is_file():
+            bank = load_anchor_bank(self.anchor_bank_path)
+            meta = bank["metadata"]
+            if ([str(Path(p).resolve()) for p in meta.get("part_mesh_paths", [])] != spec["parts"] or
+                    meta.get("joint_type", "revolute") != kind or
+                    not np.allclose(meta["joint_axis_o"], np.asarray(spec["axis"]) / np.linalg.norm(spec["axis"])) or
+                    not np.allclose(meta["joint_origin_o"], spec.get("origin", [0, 0, 0]))):
+                raise ValueError("Existing anchor bank does not match the joint definition")
+            # Limits can legitimately be widened between runs; keep source points.
+            if kind == "revolute":
+                meta["theta_limits_rad"] = limits["theta_limits_rad"]
+            else:
+                meta["joint_limits_external"] = limits["joint_limits"]
+        else:
+            bank = sample_articulated_mesh_anchors(
+                spec["parts"], self.articulated_anchors, spec["axis"], spec.get("origin", [0, 0, 0]),
+                part_names=spec.get("part_names"), joint_type=kind, **limits)
+            if self.anchor_bank_path:
+                save_anchor_bank(self.anchor_bank_path, bank)
