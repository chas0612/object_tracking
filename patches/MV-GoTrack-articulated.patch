+        return pose, float(theta_init), 0
+
+    pose_initial, theta_initial, rounds = _fit(None)
+    residuals_initial = compute_articulated_fit_residuals(
+        pose_initial, theta_initial, source, target, parts, axis_o, origin_o,
+        joint_type=kind)
+
+    # Does the fitted angle explain the moving anchors, or only the static ones?
+    # Medians, so a few bad anchors on either part cannot decide it.
+    static_mask, moving_mask = (parts != 1), (parts == 1)
+    theta_rejected = False
+    residual_ratio = float("nan")
