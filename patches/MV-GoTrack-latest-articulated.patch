+    source, parts = _anchors(rng)
+    pose_true = _random_pose(rng)
+    target = _observe(source, parts, pose_true, 0.30)
+    result = robust_fit_articulated_pose_from_anchors(
+        source, target, np.ones(len(source)), parts, AXIS, BOGUS_ORIGIN,
+        inlier_threshold_mm=8.0, joint_type="prismatic", joint_limits=TRAVEL)
+    _check("clamped to the travel stop", abs(result["joint_value"] - TRAVEL[1]) < 1e-9,
+           f"{result['joint_value']:.6f} m")
+    _check("and says so", bool(result["theta_clamped"]))
