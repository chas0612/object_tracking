+        self.joint = articulation_from_anchor_bank(self._anchor_cache[object_id], units="external")
+        self._args.num_anchors = self._args.max_active_anchors_per_view = len(bank["positions_o"])
+        self.canonical_mesh, moving = fuse_articulated_parts(spec["parts"])
+        self.moving_vertices = moving
+        self.canonical_vertices = np.asarray(self.canonical_mesh.vertices, dtype=np.float32).copy()
+        renderer = self._model.renderer
+        renderer.free_object_buffers(object_id)
+        renderer.object_meshes[object_id] = self.canonical_mesh
+        renderer.add_object_model(obj_id=object_id)
+        renderer.set_object_joint(object_id, moving, self.joint["joint_axis_o"],
+                                  self.joint["joint_origin_o"], joint_type=kind)
+        # Projection overrides are per adapter; another rigid adapter can coexist.
+        original = self._runner
+        self._runner = SimpleNamespace(**vars(original))
+        from utils.anchor_tracking import project_anchors_to_view
+        self._projection = project_anchors_to_view
+        self._runner.project_anchors_to_view = self._project
