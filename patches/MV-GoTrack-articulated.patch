+#!/usr/bin/env python3
+"""Exercise the runtime's articulated path without a GPU, a model, or a capture.
+
+The tracker's real loop needs cameras, checkpoints and images. The wiring it grew
+does not: what was added is a joint travelling from an anchor bank into the
+projection and the fit, an angle carried between frames, and a per-frame record
+that says whether the angle was measured or merely held. All of that is decidable
+from arrays.
+
+The failure this is really guarding against is the joint arriving in the wrong
+units or the anchors being swung twice -- neither raises, both quietly return an
+angle that means nothing.
+
+Run: python tests/test_articulated_runtime_wiring.py
+"""
+
+from __future__ import annotations
+
+import json
+import sys
+import tempfile
+from pathlib import Path
+
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from utils.anchor_bank import (  # noqa: E402
+    articulation_from_anchor_bank,
+    load_anchor_bank,
