+#!/usr/bin/env python3
+"""Recover a known body pose and joint *displacement* from synthetic anchors.
+
+There is no prismatic object scanned and no capture of one, so this file is the only
+thing standing between the prismatic path and a silent mistake. It is written to
+cover the two failures that a real capture would *not* reveal, rather than the ones
+it would:
+
+  * A displacement is a length, so it scales between unit systems. An angle does not.
+    Every existing unit boundary was built when the joint coordinate was an angle and
+    therefore passes it through untouched, which is correct for a hinge and wrong for
+    a slide by whatever the scale factor happens to be. Nothing raises.
+  * A displacement has no period, so the half-turn reporting window that keeps a
+    215 deg hinge from being reported as -145 deg has to be skipped entirely. Left in,
+    it folds any displacement into a band around pi and returns a plausible number.
+
+Both would produce a track that runs, reports sensible-looking residuals, and is
+wrong. The solver, by contrast, fails loudly when it is wrong, which is why it gets
+less attention here than the bookkeeping around it.
+
+Run: python tests/test_prismatic_joint.py
+"""
+
+from __future__ import annotations
+
+import sys
+import tempfile
+from pathlib import Path
+
+import numpy as np
+import trimesh
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from utils.anchor_bank import (  # noqa: E402
+    articulation_from_anchor_bank,
+    load_anchor_bank,
+    prepare_anchor_bank_for_gotrack,
+    sample_articulated_mesh_anchors,
+    save_anchor_bank,
+)
+from utils.multiview_geometry import (  # noqa: E402
+    compute_articulated_fit_residuals,
+    fit_articulated_transform_weighted,
+    fit_joint_displacement_weighted,
+    joint_transform,
+    robust_fit_articulated_pose_from_anchors,
+)
+
+# A drawer: a 200 x 200 x 150 mm housing with a slightly smaller drawer sliding out
+# along +y. Metres, matching the capture units the rest of the pipeline uses.
+AXIS = np.array([0.0, 1.0, 0.0])
+# Deliberately not the origin of anything. A sliding joint has no centre, and this
+# value existing in the tests is what proves the code ignores it.
+BOGUS_ORIGIN = np.array([0.31, -0.47, 0.22])
+TRAVEL = (0.0, 0.15)
+FAILURES: list[str] = []
+
+
+def _check(name: str, condition: bool, detail: str = "") -> None:
+    print(f"  {'PASS' if condition else 'FAIL'}  {name}{'  ' + detail if detail else ''}")
+    if not condition:
+        FAILURES.append(name)
+
+
+def _random_pose(rng: np.random.Generator) -> np.ndarray:
+    axis = rng.normal(size=3)
+    axis /= np.linalg.norm(axis)
+    angle = rng.uniform(0.0, np.pi)
+    cross = np.array([[0.0, -axis[2], axis[1]],
+                      [axis[2], 0.0, -axis[0]],
+                      [-axis[1], axis[0], 0.0]])
+    pose = np.eye(4)
+    pose[:3, :3] = (np.eye(3) + np.sin(angle) * cross
+                    + (1.0 - np.cos(angle)) * (cross @ cross))
+    pose[:3, 3] = rng.uniform(-0.5, 0.5, size=3)
+    return pose
+
+
+def _anchors(rng: np.random.Generator, n_housing: int = 120, n_drawer: int = 80):
+    """Anchors on the housing and on the drawer front and sides.
+
+    Unlike a hinge there is no such thing as an anchor with no lever arm here: every
+    anchor on the moving part has the same sensitivity to the displacement, so where
+    they sit does not matter to the solve. It matters to nothing else in this file
+    either, which is itself the point being recorded.
+    """
+    housing = np.column_stack([rng.uniform(-0.10, 0.10, n_housing),
+                               rng.uniform(-0.10, 0.10, n_housing),
+                               rng.uniform(-0.075, 0.075, n_housing)])
+    drawer = np.column_stack([rng.uniform(-0.09, 0.09, n_drawer),
+                              rng.uniform(-0.09, 0.09, n_drawer),
+                              rng.uniform(-0.065, 0.065, n_drawer)])
+    source = np.vstack([housing, drawer])
+    parts = np.concatenate([np.zeros(n_housing, dtype=int), np.ones(n_drawer, dtype=int)])
+    return source, parts
+
+
+def _observe(source, parts, pose, displacement):
+    posed = source.copy()
+    moving = parts == 1
+    transform = joint_transform(AXIS, BOGUS_ORIGIN, displacement, joint_type="prismatic")
+    posed[moving] = source[moving] @ transform[:3, :3].T + transform[:3, 3]
+    return posed @ pose[:3, :3].T + pose[:3, 3]
+
+
+def _write_boxes(directory: Path) -> tuple[Path, Path]:
+    housing = trimesh.creation.box(extents=(0.20, 0.20, 0.15))
+    drawer = trimesh.creation.box(extents=(0.18, 0.18, 0.13))
+    housing_path, drawer_path = directory / "housing.obj", directory / "drawer.obj"
+    housing.export(housing_path)
+    drawer.export(drawer_path)
+    return housing_path, drawer_path
+
+
+def test_transform_is_a_pure_translation() -> None:
+    """The joint transform itself, and its indifference to the origin."""
+    print("\nprismatic joint transform")
+    for displacement in (0.0, 0.05, -0.05, 7.5):
+        transform = joint_transform(AXIS, BOGUS_ORIGIN, displacement, joint_type="prismatic")
+        expected = np.eye(4)
+        expected[:3, 3] = displacement * AXIS
+        _check(f"d {displacement:+7.3f} m is a pure translation",
+               np.allclose(transform, expected, atol=1e-12),
+               f"max dev {np.abs(transform - expected).max():.2e}")
+
+    # A sliding part has no centre, so a caller passing one -- and every caller will,
+    # because the joint description carries an origin field -- must not change the
+    # answer. If this ever fails it means the origin has been wired into the prismatic
+    # branch, and every bank whose origin is in the wrong unit system becomes wrong.
+    a = joint_transform(AXIS, np.zeros(3), 0.06, joint_type="prismatic")
+    b = joint_transform(AXIS, BOGUS_ORIGIN * 1000.0, 0.06, joint_type="prismatic")
+    _check("origin is ignored", np.allclose(a, b, atol=1e-15))
+
+    # Only the direction of the axis matters; its length must not leak into the
+    # displacement, or the joint travels by |axis| times too much.
+    scaled = joint_transform(AXIS * 37.0, BOGUS_ORIGIN, 0.06, joint_type="prismatic")
+    _check("axis length does not scale the travel",
+           np.allclose(scaled, a, atol=1e-15))
+
+
+def test_displacement_alone() -> None:
+    """The one-dimensional solve, isolated from the pose."""
+    print("\njoint displacement alone, body frame")
+    rng = np.random.default_rng(1)
+    source, parts = _anchors(rng)
+    drawer = source[parts == 1]
+    for truth in (-0.05, 0.0, 0.075, 0.15, 7.5):
+        transform = joint_transform(AXIS, BOGUS_ORIGIN, truth, joint_type="prismatic")
+        target = drawer @ transform[:3, :3].T + transform[:3, 3]
+        solved = fit_joint_displacement_weighted(
+            drawer, target, np.ones(len(drawer)), AXIS)
+        _check(f"d {truth:+7.3f} m", abs(solved - truth) < 1e-12,
+               f"err {abs(solved - truth):.2e} m")
+
+
+def test_exact() -> None:
+    """Pose and displacement together, no noise."""
+    print("\nexact anchors")
+    rng = np.random.default_rng(0)
+    for truth in (0.0, 0.037, 0.15, -0.05):
+        pose_true = _random_pose(rng)
+        source, parts = _anchors(rng)
+        target = _observe(source, parts, pose_true, truth)
+        pose, solved, rounds = fit_articulated_transform_weighted(
+            source, target, np.ones(len(source)), parts, AXIS, BOGUS_ORIGIN,
+            joint_type="prismatic")
+        shift = np.linalg.norm(pose[:3, 3] - pose_true[:3, 3]) * 1000.0
+        # The alternation stops when its step falls below tolerance_rad, which for a
+        # prismatic joint is a length -- 1 nm at the default. A few times that is what
+        # remains, so asserting at the tolerance itself would be asserting that the
+        # loop overshoots its own stopping rule. 0.1 um is four orders below anything
+        # this pipeline can measure.
+        _check(f"d {truth:+7.3f} m recovered", abs(solved - truth) < 1e-7,
+               f"err {abs(solved - truth):.2e} m, {shift:.2e} mm, {rounds} rounds")
+
+
+def test_displacement_is_never_wrapped() -> None:
+    """The half-turn reporting window must not touch a displacement.
+
+    This is the test that would have caught the wrap being left in. Each value below
+    is one the revolute path deliberately folds: read as radians, -0.05 reports as
+    6.23 and 7.5 as 1.22. Read as a length they must come back exactly as given, and
+    the failure mode if they do not is a number in the right ballpark rather than an
+    exception -- 1.22 m of drawer travel is wrong but not obviously so.
+    """
+    print("\nno reporting window on a displacement")
+    rng = np.random.default_rng(2)
+    for truth in (-0.05, 7.5, 2 * np.pi + 0.4):
+        pose_true = _random_pose(rng)
+        source, parts = _anchors(rng)
+        target = _observe(source, parts, pose_true, truth)
+        # Started near the answer, the way tracking always calls this -- the previous
+        # frame's value. Whether a distant start converges is a separate question with
+        # its own test below; this one is only about how the answer is reported.
+        _, solved, _ = fit_articulated_transform_weighted(
+            source, target, np.ones(len(source)), parts, AXIS, BOGUS_ORIGIN,
+            joint_type="prismatic", theta_init=0.9 * truth)
+        folded = np.pi + np.arctan2(np.sin(truth - np.pi), np.cos(truth - np.pi))
+        _check(f"d {truth:+7.3f} kept, not folded to {folded:+.3f}",
+               abs(solved - truth) < 1e-6, f"got {solved:+.6f}")
+
+    # And the same value through the revolute path *is* folded, so the test above is
+    # measuring a real branch rather than a wrap that never fired.
+    source, parts = _anchors(rng)
+    pose_true = _random_pose(rng)
+    posed = source.copy()
+    transform = joint_transform(AXIS, BOGUS_ORIGIN, -0.05)
+    posed[parts == 1] = source[parts == 1] @ transform[:3, :3].T + transform[:3, 3]
+    target = posed @ pose_true[:3, :3].T + pose_true[:3, 3]
+    _, angle, _ = fit_articulated_transform_weighted(
+        source, target, np.ones(len(source)), parts, AXIS, BOGUS_ORIGIN)
+    _check("revolute still folds -0.05 rad into [0, 2pi)", angle > 6.0,
+           f"revolute reports {angle:+.4f} rad")
+
+
+def test_far_displacement_needs_a_nearby_start() -> None:
+    """How far the alternation reaches from a cold start, and that it fails loudly.
+
+    Starting at zero, the first Kabsch has to explain moving anchors that are already
+    displaced, so a large enough displacement drags the initial body pose somewhere
+    the alternation cannot climb back from. Measured here: reliable out to about ten
+    times the part's half-size, degrading past that. A drawer travels roughly its own
+    length, so nothing physical comes close -- this is recorded because it is the one
+    place the prismatic solve is worse behaved than the hinge, not because it is
+    expected to bind.
+
+    The useful half is that it does not fail quietly. The wrong minimum leaves a mean
+    residual around 0.1 m against 1e-7 m for the right one, so the existing inlier
+    threshold rejects it. That is the opposite of the angle runaway, which was
+    dangerous precisely because its residuals stayed healthy.
+    """
+    print("\ncold-start reach")
+    rng = np.random.default_rng(11)
+    for truth, expected in ((0.15, 20), (1.0, 20)):
+        recovered = 0
+        for _ in range(20):
+            pose_true = _random_pose(rng)
+            source, parts = _anchors(rng)
+            target = _observe(source, parts, pose_true, truth)
+            _, solved, _ = fit_articulated_transform_weighted(
+                source, target, np.ones(len(source)), parts, AXIS, BOGUS_ORIGIN,
+                joint_type="prismatic")
+            recovered += abs(solved - truth) < 1e-6
+        _check(f"d {truth:.2f} m ({truth / 0.1:.0f}x half-size) from a cold start",
+               recovered == expected, f"{recovered}/20")
+
+    # A displacement far outside any plausible travel, from a cold start: the point is
+    # not that it converges but that when it does not, the residual says so.
+    rng = np.random.default_rng(2)
+    for _ in range(2):
+        pose_true, (source, parts) = _random_pose(rng), _anchors(rng)
+    target = _observe(source, parts, pose_true, 2 * np.pi + 0.4)
+    pose, solved, _ = fit_articulated_transform_weighted(
+        source, target, np.ones(len(source)), parts, AXIS, BOGUS_ORIGIN,
+        joint_type="prismatic")
+    residuals = compute_articulated_fit_residuals(
+        pose, solved, source, target, parts, AXIS, BOGUS_ORIGIN, joint_type="prismatic")
+    missed = abs(solved - (2 * np.pi + 0.4)) > 1e-6
+    _check("a missed cold start is visible in the residual",
+           (not missed) or float(np.mean(residuals)) > 1e-3,
+           f"d {solved:+.4f}, mean residual {float(np.mean(residuals)):.3e} m")
+
+
+def test_noise() -> None:
+    """Gaussian anchor noise, at and above what triangulation delivers."""
+    print("\nnoisy anchors")
+    rng = np.random.default_rng(3)
+    for sigma_mm in (1.0, 3.0, 10.0):
+        errors = []
+        for _ in range(20):
+            pose_true = _random_pose(rng)
+            source, parts = _anchors(rng)
+            truth = float(rng.uniform(*TRAVEL))
+            target = _observe(source, parts, pose_true, truth)
+            target += rng.normal(scale=sigma_mm / 1000.0, size=target.shape)
+            _, solved, _ = fit_articulated_transform_weighted(
+                source, target, np.ones(len(source)), parts, AXIS, BOGUS_ORIGIN,
+                joint_type="prismatic")
+            errors.append(abs(solved - truth) * 1000.0)
+        median = float(np.median(errors))
+        # Averaging n anchors shrinks the noise, so the displacement should come back
+        # tighter than a single anchor's error rather than merely comparable to it.
+        _check(f"sigma {sigma_mm:4.1f} mm -> displacement error below it",
+               median < sigma_mm, f"median {median:.3f} mm, max {max(errors):.3f} mm")
+
+
+def test_limit_mixups_are_errors() -> None:
+    """Radians offered to a sliding joint must raise rather than be reinterpreted."""
+    print("\nlimit and unit guards")
+    rng = np.random.default_rng(4)
+    source, parts = _anchors(rng)
+    target = _observe(source, parts, np.eye(4), 0.05)
+    common = dict(inlier_threshold_mm=8.0, external_unit_scale_to_meter=1.0)
+
+    def _raises(name: str, **kwargs) -> None:
+        try:
+            robust_fit_articulated_pose_from_anchors(
+                source, target, np.ones(len(source)), parts, AXIS, BOGUS_ORIGIN,
+                **common, **kwargs)
+        except ValueError:
+            _check(name, True)
+        else:
+            _check(name, False, "no ValueError raised")
+
+    _raises("radian limits on a prismatic joint",
+            joint_type="prismatic", theta_limits_rad=(0.0, 0.15))
+    _raises("a reporting window on a prismatic joint",
+            joint_type="prismatic", theta_reference_rad=np.pi)
+    _raises("both limit arguments at once",
+            theta_limits_rad=(0.0, 1.0), joint_limits=(0.0, 1.0))
+    _raises("an unknown joint type", joint_type="helical")
+
+
+def test_record_omits_angle_keys() -> None:
+    """A prismatic result must not carry a number named as an angle."""
+    print("\nresult record")
+    rng = np.random.default_rng(5)
+    source, parts = _anchors(rng)
+    pose_true = _random_pose(rng)
+    target = _observe(source, parts, pose_true, 0.062)
+    result = robust_fit_articulated_pose_from_anchors(
+        source, target, np.ones(len(source)), parts, AXIS, BOGUS_ORIGIN,
+        inlier_threshold_mm=8.0, joint_type="prismatic")
+    _check("status ok", result["status"] == "ok", result["status"])
+    _check("joint_type reported", result.get("joint_type") == "prismatic")
