+
+    ``units`` picks which copy of the origin to return. Both the projection and the
+    fit work in external units -- they read ``positions_o_external`` -- so that is
+    the default and the other is here for callers working inside GoTrack's scale.
+    Getting this wrong does not raise: the hinge simply sits a thousand times too
+    far away and the angle comes out meaningless, so the choice is explicit.
+    """
+    metadata = anchor_bank.get("metadata") or {}
+    if not metadata.get("articulated") or "joint_axis_o" not in metadata:
+        return None
+    part_ids = np.asarray(anchor_bank.get(
+        "part_ids", np.zeros(len(anchor_bank["positions_o"]), dtype=np.int64)), dtype=np.int64)
+    if units == "gotrack":
+        origin = metadata.get("joint_origin_o_gotrack", metadata["joint_origin_o"])
+    elif units == "external":
