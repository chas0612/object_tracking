+def joint_transform(axis_o: np.ndarray, origin_o: np.ndarray, theta: float) -> np.ndarray:
+    """Rotation of ``theta`` about the line through ``origin_o`` along ``axis_o``.
+
+    Object frame throughout, in whatever units the anchor bank uses -- the origin
+    shares those units, the axis is dimensionless.
+    """
+    axis = np.asarray(axis_o, dtype=np.float64).reshape(3)
+    norm = float(np.linalg.norm(axis))
+    if norm < 1.0e-12:
+        raise ValueError("Joint axis is degenerate")
+    axis = axis / norm
+    origin = np.asarray(origin_o, dtype=np.float64).reshape(3)
+
+    cross = np.array([[0.0, -axis[2], axis[1]],
+                      [axis[2], 0.0, -axis[0]],
+                      [-axis[1], axis[0], 0.0]], dtype=np.float64)
+    rotation = (np.eye(3)
+                + np.sin(theta) * cross
+                + (1.0 - np.cos(theta)) * (cross @ cross))
+    pose = np.eye(4, dtype=np.float64)
+    pose[:3, :3] = rotation
+    pose[:3, 3] = origin - rotation @ origin
+    return pose
+
+
+def fit_joint_angle_weighted(
+    source_points_o: np.ndarray,
+    target_points_o: np.ndarray,
+    weights: np.ndarray,
+    axis_o: np.ndarray,
+    origin_o: np.ndarray,
+) -> float:
+    """The angle about a *known* axis that best carries source onto target.
+
+    Both point sets live in the body frame, so the caller has already undone the
+    body pose. With the axis fixed this is one degree of freedom and it has a
+    closed form: drop the component along the axis, and the weighted least-squares
+    rotation in the remaining plane is the argument of the summed complex product.
+
+    Closed form rather than a numerical search on purpose. The silhouette work on
+    this object spent a long time on an optimiser that stopped early on a bumpy
+    surface and returned answers that differed by 8.9 deg from equivalent starts;
+    nothing here can stop early because there is nothing to iterate.
+    """
+    axis = np.asarray(axis_o, dtype=np.float64).reshape(3)
+    axis = axis / float(np.linalg.norm(axis))
+    origin = np.asarray(origin_o, dtype=np.float64).reshape(3)
+    source = np.asarray(source_points_o, dtype=np.float64).reshape(-1, 3) - origin
+    target = np.asarray(target_points_o, dtype=np.float64).reshape(-1, 3) - origin
+    weight = np.asarray(weights, dtype=np.float64).reshape(-1)
+
+    # Only the components perpendicular to the axis can move, so the parallel part
+    # carries no information about the angle and is removed from both sides.
+    source_perp = source - np.outer(source @ axis, axis)
+    target_perp = target - np.outer(target @ axis, axis)
+
+    # An anchor sitting on the axis has no lever arm; its perpendicular component is
+    # numerical noise pointing in an arbitrary direction. The cross and dot products
+    # below already weight by the two radii, so such anchors fall out on their own.
+    cosine = np.sum(weight * np.sum(source_perp * target_perp, axis=1))
+    sine = np.sum(weight * (np.cross(source_perp, target_perp) @ axis))
+    if abs(cosine) < 1.0e-18 and abs(sine) < 1.0e-18:
+        return 0.0
+    return float(np.arctan2(sine, cosine))
