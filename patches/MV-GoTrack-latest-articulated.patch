+        "part_mesh_paths": [str(p) for p in paths],
+        "part_names": list(part_names) if part_names is not None
+        else [p.stem for p in paths],
+        "part_anchor_counts": [int(c) for c in counts],
+        "part_areas": areas.tolist(),
+        "mesh_scale": float(mesh_scale),
+        "anchor_unit_space": "external_mesh",
+        "num_anchors": int(merged["positions_o"].shape[0]),
+        "method": str(method),
+        "seed": int(seed),
+        "mesh_num_vertices": int(vertex_offset),
+        "mesh_num_faces": int(sum(int(np.asarray(m.faces).shape[0]) for m in meshes)),
+        "articulated": True,
+        "joint_type": kind,
+        # External mesh units, matching positions_o. The axis is a direction and so
+        # is unitless; the origin is a point and scales with the anchors.
+        "joint_axis_o": axis.tolist(),
+        "joint_origin_o": np.asarray(joint_origin_o, dtype=np.float64).reshape(3).tolist(),
+        "theta_limits_rad": (None if theta_limits_rad is None
+                             else [float(v) for v in theta_limits_rad]),
+        "moving_part_id": 1,
+    }
+    # A revolute range is already fully described by theta_limits_rad above, and
+    # duplicating it under a second name would leave two keys to keep in step. A
+    # prismatic range is a pair of lengths and gets the same treatment as the origin.
+    if kind == "prismatic" and joint_limits is not None:
+        merged["metadata"]["joint_limits_external"] = [float(v) for v in joint_limits]
+    return merged
