+#!/usr/bin/env python3
+"""Build an articulated anchor bank from the real box parts and fit against it.
+
+The solver test uses invented anchors. This one uses the actual body and lid meshes
+and the joint measured from the two scans, so it also exercises the parts that only
+break on real data: apportioning anchors between meshes of very different area,
+offsetting face and vertex indices onto the fused mesh, and carrying the joint into
+GoTrack's internal units -- where the origin scales and the axis must not.
+
+Run: python tests/test_articulated_anchor_bank.py
+"""
+
+from __future__ import annotations
+
+import json
+import sys
+import tempfile
+from pathlib import Path
+
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from utils.anchor_bank import (  # noqa: E402
+    load_anchor_bank,
+    load_mesh,
+    prepare_anchor_bank_for_gotrack,
+    sample_articulated_mesh_anchors,
+    save_anchor_bank,
+)
+from utils.multiview_geometry import (  # noqa: E402
+    joint_transform,
+    robust_fit_articulated_pose_from_anchors,
+)
+
+PARTS = Path.home() / "shared_data/mesh_new/blue_plastic_box/articulation_particulate"
+FAILURES: list[str] = []
+
+
+def _check(name: str, condition: bool, detail: str = "") -> None:
+    print(f"  {'PASS' if condition else 'FAIL'}  {name}{'  ' + detail if detail else ''}")
+    if not condition:
+        FAILURES.append(name)
+
+
+def main() -> int:
+    joint = json.loads((PARTS / "joint.json").read_text(encoding="utf-8"))["measured"]
+    axis = np.asarray(joint["axis"], dtype=np.float64)
+    origin = np.asarray(joint["origin"], dtype=np.float64)
+    limits = tuple(float(v) for v in joint["range_rad"])
+    body_path, lid_path = PARTS / "parts/body.obj", PARTS / "parts/lid.obj"
+
+    print("\nsampling")
+    bank = sample_articulated_mesh_anchors(
+        [body_path, lid_path], num_anchors=512,
+        joint_axis_o=axis, joint_origin_o=origin,
+        part_names=["body", "lid"], theta_limits_rad=limits, seed=0)
+    parts = bank["part_ids"]
+    meta = bank["metadata"]
+    _check("anchor count honoured", bank["positions_o"].shape[0] == 512,
+           f"{bank['positions_o'].shape[0]} anchors")
+    _check("both parts sampled", set(np.unique(parts).tolist()) == {0, 1},
+           f"body {int((parts == 0).sum())}, lid {int((parts == 1).sum())}")
+
+    # Density, not count, should match: the lid is much the smaller part.
+    areas = meta["part_areas"]
+    density = [int((parts == i).sum()) / areas[i] for i in (0, 1)]
+    _check("density is uniform across parts",
+           abs(density[0] - density[1]) / max(density) < 0.05,
+           f"{density[0]:.0f} vs {density[1]:.0f} anchors per m^2, "
+           f"areas {areas[0]:.4f} / {areas[1]:.4f} m^2")
+
+    body_mesh, lid_mesh = load_mesh(body_path), load_mesh(lid_path)
+    n_body_faces = int(np.asarray(body_mesh.faces).shape[0])
+    n_body_verts = int(np.asarray(body_mesh.vertices).shape[0])
+    total_faces = n_body_faces + int(np.asarray(lid_mesh.faces).shape[0])
+    _check("face indices land on the fused mesh",
+           int(bank["face_indices"][parts == 0].max()) < n_body_faces
+           and int(bank["face_indices"][parts == 1].min()) >= n_body_faces
+           and int(bank["face_indices"].max()) < total_faces,
+           f"body < {n_body_faces} <= lid, max {int(bank['face_indices'].max())}")
+    _check("vertex indices offset with them",
+           int(bank["vertex_indices"][parts == 1].min()) >= n_body_verts)
+
+    print("\ngotrack units")
+    scale = 1000.0  # metres in, millimetres inside GoTrack
+    prepared = prepare_anchor_bank_for_gotrack(bank, translation_scale_to_gotrack=scale)
+    pm = prepared["metadata"]
+    _check("origin scales with the anchors",
+           np.allclose(pm["joint_origin_o_gotrack"], origin * scale),
+           f"{np.asarray(pm['joint_origin_o_gotrack']).round(2).tolist()}")
+    _check("axis does not scale",
+           np.allclose(pm["joint_axis_o_gotrack"], axis / np.linalg.norm(axis))
+           and abs(np.linalg.norm(pm["joint_axis_o_gotrack"]) - 1.0) < 1e-9)
+
+    print("\nsave and load")
+    with tempfile.TemporaryDirectory() as tmp:
+        path = Path(tmp) / "bank.npz"
+        save_anchor_bank(path, prepared)
+        restored = load_anchor_bank(path)
+    _check("part ids survive the round trip",
+           np.array_equal(restored["part_ids"], parts))
+    _check("joint survives the round trip",
+           np.allclose(restored["metadata"]["joint_axis_o"], pm["joint_axis_o"])
+           and np.allclose(restored["metadata"]["joint_origin_o"], pm["joint_origin_o"]))
+
+    print("\nfit against this bank")
+    rng = np.random.default_rng(0)
+    source = restored["positions_o"].astype(np.float64)
+    for theta_true_deg in (0.0, 47.4, 163.6, 205.7):
+        pose_true = np.eye(4)
+        pose_true[:3, 3] = [0.4, -0.1, 0.25]
+        angle = np.radians(37.0)
+        pose_true[:3, :3] = np.array([[np.cos(angle), -np.sin(angle), 0.0],
+                                      [np.sin(angle), np.cos(angle), 0.0],
+                                      [0.0, 0.0, 1.0]])
+        posed = source.copy()
+        moving = parts == 1
+        transform = joint_transform(axis, origin, np.radians(theta_true_deg))
+        posed[moving] = source[moving] @ transform[:3, :3].T + transform[:3, 3]
+        target = posed @ pose_true[:3, :3].T + pose_true[:3, 3]
+        target += rng.normal(scale=0.003, size=target.shape)   # 3 mm triangulation noise
+
+        result = robust_fit_articulated_pose_from_anchors(
+            source, target, np.ones(len(source)), parts, axis, origin,
+            inlier_threshold_mm=15.0, theta_limits_rad=limits)
+        error = abs(result["theta_deg"] - theta_true_deg)
+        shift = np.linalg.norm(
+            result["pose_world_from_object"][:3, 3] - pose_true[:3, 3]) * 1000.0
+        _check(f"theta {theta_true_deg:6.1f} deg", error < 1.0 and not result["theta_clamped"],
+               f"err {error:.3f} deg, shift {shift:.2f} mm, "
+               f"{result['num_inlier_anchors']}/{result['num_input_anchors']} inliers")
+
+    # Projection and fit have to be exact inverses. Each is self-consistent on its
+    # own even if the joint is applied twice, or with the wrong sign, or in the wrong
+    # frame -- the error only shows when one is asked to undo the other.
+    print("\nprojection and fit agree")
+    from utils.anchor_tracking import project_anchors_to_view  # noqa: E402
+
+    pose_true = np.eye(4)
+    pose_true[:3, 3] = [0.35, -0.05, 0.30]
+    tilt = np.radians(20.0)
+    pose_true[:3, :3] = np.array([[1.0, 0.0, 0.0],
+                                  [0.0, np.cos(tilt), -np.sin(tilt)],
+                                  [0.0, np.sin(tilt), np.cos(tilt)]])
+    intrinsic = np.array([[900.0, 0.0, 640.0], [0.0, 900.0, 480.0], [0.0, 0.0, 1.0]])
+    extrinsic = np.eye(4)
+    extrinsic[:3, 3] = [0.0, 0.0, 1.2]
+
+    for theta_true_deg in (0.0, 90.0, 163.6):
+        theta_true = np.radians(theta_true_deg)
+        projected = project_anchors_to_view(
+            source.astype(np.float32), pose_true, extrinsic, intrinsic, (1280, 960),
+            part_ids=parts, joint_axis_o=axis, joint_origin_o=origin, theta=theta_true)
+
+        # The canonical anchors must come back untouched, or a caller that hands
+        # them to the fit would apply the joint a second time.
+        _check(f"theta {theta_true_deg:5.1f}: canonical anchors unchanged",
+               np.allclose(projected["anchors_o"], source.astype(np.float32)))
+
+        # Feed the projection's own world points straight back to the fit.
+        result = robust_fit_articulated_pose_from_anchors(
+            source, projected["points_world"].astype(np.float64),
+            np.ones(len(source)), parts, axis, origin,
+            inlier_threshold_mm=5.0, theta_limits_rad=limits)
+        angle_error = abs(result["theta_deg"] - theta_true_deg)
+        pose_error = float(np.max(np.abs(
+            np.asarray(result["pose_world_from_object"], dtype=np.float64) - pose_true)))
+        _check(f"theta {theta_true_deg:5.1f}: fit inverts the projection",
+               angle_error < 0.05 and pose_error < 1.0e-3,
+               f"theta err {angle_error:.4f} deg, pose max err {pose_error:.2e}")
+
+    # A bank saved before articulation existed must still load and fit.
+    print("\nbackward compatibility")
+    legacy = {k: bank[k] for k in
+              ("positions_o", "normals_o", "face_indices", "vertex_indices", "barycentric")}
+    legacy["metadata"] = {"anchor_unit_space": "external_mesh"}
+    with tempfile.TemporaryDirectory() as tmp:
+        path = Path(tmp) / "legacy.npz"
+        save_anchor_bank(path, legacy)
+        restored_legacy = load_anchor_bank(path)
+    _check("legacy bank loads as one rigid part",
+           np.array_equal(restored_legacy["part_ids"],
+                          np.zeros(len(source), dtype=np.int64)))
+    rigid = robust_fit_articulated_pose_from_anchors(
+        source, source, np.ones(len(source)), restored_legacy["part_ids"], axis, origin,
+        inlier_threshold_mm=15.0)
+    _check("and reports the angle as unobserved", rigid["status"] == "theta_unobserved",
+           f"status {rigid['status']}, theta_observed={rigid['theta_observed']}")
+
+    print(f"\n{len(FAILURES)} failures" + (f": {FAILURES}" if FAILURES else ""))
+    return 1 if FAILURES else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
