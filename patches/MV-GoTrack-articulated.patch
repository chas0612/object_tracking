+JOINT_TYPES = ("revolute", "prismatic")
+
+
+def validate_joint_type(joint_type: str) -> str:
+    """Reject an unknown joint type here rather than silently treating it as a hinge.
+
+    Every joint-aware function funnels through this, so a typo in a config file
+    surfaces as an error naming the valid options instead of a plausible-looking
+    track of the wrong kind.
+    """
+    name = str(joint_type)
+    if name not in JOINT_TYPES:
+        raise ValueError(f"joint_type must be one of {JOINT_TYPES}, got {joint_type!r}")
+    return name
+
+
+def joint_transform(
+    axis_o: np.ndarray,
+    origin_o: np.ndarray,
+    theta: float,
+    *,
+    joint_type: str = "revolute",
+) -> np.ndarray:
+    """The transform a joint coordinate applies to the part beyond the joint.
+
+    ``revolute`` -- rotation of ``theta`` about the line through ``origin_o`` along
+    ``axis_o``. ``prismatic`` -- translation of ``theta`` along ``axis_o``.
+
+    Object frame throughout, in whatever units the anchor bank uses. Which of the
+    three arguments carries those units differs by type, and that asymmetry is the
+    thing to get right:
+
+    ==============  ===============  ==============  ==================
+    argument        revolute         prismatic       scales with units?
+    ==============  ===============  ==============  ==================
+    ``axis_o``      direction        direction       no
+    ``origin_o``    a point          *unused*        yes (revolute only)
+    ``theta``       radians          a length        prismatic only
+    ==============  ===============  ==============  ==================
+
+    A revolute angle is dimensionless, so it survives a change of unit system
+    untouched. A prismatic displacement does not -- it is a length and has to be
+    scaled at every unit boundary exactly like the origin. ``origin_o`` is accepted
+    and ignored for a prismatic joint so that callers can pass a joint description
+    through without branching; a sliding part has no centre.
+
+    This is the single point where the joint type is interpreted. Anchor projection,
+    the renderer, the residuals and the wrong-surface test all reach the geometry
+    through here, so they are joint-type agnostic and need no changes of their own.
+    """
+    kind = validate_joint_type(joint_type)
+    axis = np.asarray(axis_o, dtype=np.float64).reshape(3)
+    norm = float(np.linalg.norm(axis))
+    if norm < 1.0e-12:
+        raise ValueError("Joint axis is degenerate")
+    axis = axis / norm
+
+    pose = np.eye(4, dtype=np.float64)
+    if kind == "prismatic":
+        pose[:3, 3] = float(theta) * axis
+        return pose
+
+    origin = np.asarray(origin_o, dtype=np.float64).reshape(3)
+    cross = np.array([[0.0, -axis[2], axis[1]],
+                      [axis[2], 0.0, -axis[0]],
+                      [-axis[1], axis[0], 0.0]], dtype=np.float64)
+    rotation = (np.eye(3)
+                + np.sin(theta) * cross
+                + (1.0 - np.cos(theta)) * (cross @ cross))
+    pose[:3, :3] = rotation
+    pose[:3, 3] = origin - rotation @ origin
+    return pose
+
+
+def fit_joint_angle_weighted(
+    source_points_o: np.ndarray,
+    target_points_o: np.ndarray,
+    weights: np.ndarray,
+    axis_o: np.ndarray,
+    origin_o: np.ndarray,
+) -> float:
+    """The angle about a *known* axis that best carries source onto target.
+
+    Both point sets live in the body frame, so the caller has already undone the
+    body pose. With the axis fixed this is one degree of freedom and it has a
+    closed form: drop the component along the axis, and the weighted least-squares
+    rotation in the remaining plane is the argument of the summed complex product.
+
+    Closed form rather than a numerical search on purpose. The silhouette work on
+    this object spent a long time on an optimiser that stopped early on a bumpy
+    surface and returned answers that differed by 8.9 deg from equivalent starts;
+    nothing here can stop early because there is nothing to iterate.
+    """
+    axis = np.asarray(axis_o, dtype=np.float64).reshape(3)
+    axis = axis / float(np.linalg.norm(axis))
+    origin = np.asarray(origin_o, dtype=np.float64).reshape(3)
+    source = np.asarray(source_points_o, dtype=np.float64).reshape(-1, 3) - origin
+    target = np.asarray(target_points_o, dtype=np.float64).reshape(-1, 3) - origin
+    weight = np.asarray(weights, dtype=np.float64).reshape(-1)
+
+    # Only the components perpendicular to the axis can move, so the parallel part
+    # carries no information about the angle and is removed from both sides.
+    source_perp = source - np.outer(source @ axis, axis)
+    target_perp = target - np.outer(target @ axis, axis)
+
+    # An anchor sitting on the axis has no lever arm; its perpendicular component is
+    # numerical noise pointing in an arbitrary direction. The cross and dot products
+    # below already weight by the two radii, so such anchors fall out on their own.
+    cosine = np.sum(weight * np.sum(source_perp * target_perp, axis=1))
+    sine = np.sum(weight * (np.cross(source_perp, target_perp) @ axis))
+    if abs(cosine) < 1.0e-18 and abs(sine) < 1.0e-18:
+        return 0.0
+    return float(np.arctan2(sine, cosine))
+
+
+def fit_joint_displacement_weighted(
+    source_points_o: np.ndarray,
+    target_points_o: np.ndarray,
+    weights: np.ndarray,
+    axis_o: np.ndarray,
+    origin_o: np.ndarray | None = None,
+) -> float:
+    """The slide along a *known* axis that best carries source onto target.
+
+    The prismatic counterpart of ``fit_joint_angle_weighted``, and the same contract:
+    both point sets are in the body frame, the caller has already undone the body
+    pose, and the answer is absolute -- measured from the zero-displacement pose the
+    anchors were sampled in, not a step.
+
+    Simpler than the revolute case, and unconditionally so. Each anchor moves by
+    ``d * a`` regardless of where it sits, so the residual is linear in ``d`` and the
+    weighted least-squares solution is a mean of per-anchor projections::
+
+        d* = sum_i w_i (y_i - x_i) . a / sum_i w_i
+
+    ``origin_o`` is accepted and ignored, to match the revolute signature.
+
+    Two properties follow from the linearity and are worth naming, because they are
+    where a prismatic joint differs from the hinge this code was built for. Every
+    anchor has the same sensitivity ``d r / d d = a``, so unlike a hinge there are no
+    anchors with a short lever arm that contribute nothing -- the conditioning is
+    uniform and does not depend on where the joint sits. That is the good half. The
+    bad half is that a part which is self-similar along its slide direction, which is
+    the usual shape for a drawer, produces almost the same image at displacements
+    that differ by that period. This solve will answer confidently either way; the
+    ambiguity is in the correspondences reaching it, not here.
+    """
+    axis = np.asarray(axis_o, dtype=np.float64).reshape(3)
+    axis = axis / float(np.linalg.norm(axis))
+    source = np.asarray(source_points_o, dtype=np.float64).reshape(-1, 3)
+    target = np.asarray(target_points_o, dtype=np.float64).reshape(-1, 3)
+    weight = np.asarray(weights, dtype=np.float64).reshape(-1)
+
+    total = float(np.sum(weight))
+    if not np.isfinite(total) or abs(total) < 1.0e-18:
+        return 0.0
+    return float(np.sum(weight * ((target - source) @ axis)) / total)
+
+
+def fit_articulated_transform_weighted(
+    source_points_o: np.ndarray,
+    target_points_w: np.ndarray,
+    weights: np.ndarray,
+    part_ids: np.ndarray,
+    axis_o: np.ndarray,
+    origin_o: np.ndarray,
+    *,
+    theta_init: float = 0.0,
+    theta_reference_rad: float | None = None,
+    iterations: int = 40,
+    tolerance_rad: float = 1.0e-9,
+    joint_type: str = "revolute",
+) -> tuple[np.ndarray, float, int]:
+    """Body pose and joint coordinate together, by alternating two exact solves.
+
+    The objective is the rigid one with the moving part carried through the joint::
+
+        argmin_{T, theta}  sum_body w ||T X - Y||^2
+                         + sum_lid  w ||T J(theta) X - Y||^2
+
+    Neither variable has a closed form on its own, but each does given the other:
+    fix ``theta`` and the moving anchors can be pre-swung into the body frame, which
+    leaves an ordinary weighted Kabsch; fix ``T`` and the moving anchors can be
+    pulled back into the body frame, which leaves the one-dimensional problem above.
+    Alternating exact solves is monotone in the objective and converges in a handful
+    of rounds.
+
+    ``part_ids`` is 0 for the static part and 1 for the part on the far side of the
+    joint. Returns the pose, the angle, and the number of rounds actually used.
+
+    The angle only ever enters as a rotation, so every representative differing by a
+    full turn fits equally well and the solve has no way to prefer one. Which one is
+    reported still matters: this joint opens past 180 deg, and an arctangent hands
+    back 215 deg as -145, which then reads as below a lower limit of zero and gets
+    clamped there. ``theta_reference_rad`` names the half-turn window to report in --
+    the previous frame's angle when tracking, which also keeps the series continuous.
+    Default is pi, giving [0, 2*pi), the range a hinge measured from closed occupies.
+
+    None of that applies to a ``prismatic`` joint, where the whole notion is absent
+    rather than merely different: a displacement has no period, so there is no
+    representative to choose and nothing to unwrap. Both the per-round unwrapping and
+    the closing window are skipped for it. Folding a displacement into a half-turn
+    band would not raise -- it would quietly return a number near pi, which is why
+    this is a branch and not a parameter. ``tolerance_rad`` is then a length in the
+    anchors' own units; the default is far below any of them.
+    """
+    kind = validate_joint_type(joint_type)
+    source = np.asarray(source_points_o, dtype=np.float64).reshape(-1, 3)
+    target = np.asarray(target_points_w, dtype=np.float64).reshape(-1, 3)
+    weight = np.asarray(weights, dtype=np.float64).reshape(-1)
+    moving = np.asarray(part_ids).reshape(-1) == 1
+    solve_joint = (fit_joint_displacement_weighted if kind == "prismatic"
+                   else fit_joint_angle_weighted)
+
+    def _pose_at(angle: float) -> np.ndarray:
+        # Carrying the moving anchors through the joint makes the whole set rigid
+        # again, so this is the untouched weighted Kabsch.
+        swung = source.copy()
+        if moving.any():
+            transform = joint_transform(axis_o, origin_o, angle, joint_type=kind)
+            swung[moving] = source[moving] @ transform[:3, :3].T + transform[:3, 3]
+        return _coerce_pose_matrix(
+            fit_rigid_transform_weighted(swung, target, weight)).astype(np.float64)
+
+    theta = float(theta_init)
+    pose = _pose_at(theta)
+    used = 0
+    previous_delta = 0.0
+    if moving.any():
+        for used in range(1, int(iterations) + 1):
+            # T -> theta. Bring the moving targets back into the body frame, where
+            # the remaining freedom is exactly the hinge. Unwrapped onto the running
+            # value so the alternation cannot jump a turn mid-iteration.
+            rotation, translation = pose[:3, :3], pose[:3, 3]
+            target_in_object = (target[moving] - translation) @ rotation
+            solved = solve_joint(
+                source[moving], target_in_object, weight[moving], axis_o, origin_o)
+            delta = float(solved - theta)
+            if kind == "revolute":
+                delta = float(np.arctan2(np.sin(delta), np.cos(delta)))
+            theta += delta
+
+            # Alternating exact solves converge linearly, and on some geometries the
+            # ratio is close enough to one that the tail outlives any sane iteration
+            # cap -- one pose here still had 0.009 deg left after 40 rounds. The
+            # steps shrink by a near-constant factor, so the rest of the series can
+            # be summed instead of walked: with r = delta_n / delta_{n-1} the
+            # remaining distance is delta_n * r / (1 - r). Aitken extrapolation, and
+            # the alternation that follows polishes whatever it overshoots.
+            if previous_delta != 0.0 and delta != 0.0:
+                ratio = delta / previous_delta
+                if 0.0 < ratio < 0.999:
+                    theta += delta * ratio / (1.0 - ratio)
+            previous_delta = delta
+
+            # theta -> T, every round including the last, so the pair handed back is
+            # always consistent. Returning a pose fitted at the previous angle left
+            # 3.6 deg on the table whenever the loop ran to its iteration limit.
+            pose = _pose_at(theta)
+            if abs(delta) <= tolerance_rad:
+                break
+
+    if kind == "revolute":
+        reference = np.pi if theta_reference_rad is None else float(theta_reference_rad)
+        theta = reference + float(
+            np.arctan2(np.sin(theta - reference), np.cos(theta - reference)))
+    return pose.astype(np.float32), float(theta), int(used)
+
+
+def compute_articulated_fit_residuals(
+    pose_world_from_object: np.ndarray,
+    theta: float,
+    source_points_o: np.ndarray,
+    target_points_w: np.ndarray,
+    part_ids: np.ndarray,
+    axis_o: np.ndarray,
+    origin_o: np.ndarray,
+    *,
+    joint_type: str = "revolute",
+) -> np.ndarray:
+    """Per-anchor distance, each part carried through its own transform."""
+    pose = _coerce_pose_matrix(pose_world_from_object).astype(np.float64)
+    source = np.asarray(source_points_o, dtype=np.float64).reshape(-1, 3)
+    target = np.asarray(target_points_w, dtype=np.float64).reshape(-1, 3)
+    moving = np.asarray(part_ids).reshape(-1) == 1
+
+    posed = source.copy()
+    if moving.any():
+        transform = joint_transform(axis_o, origin_o, float(theta), joint_type=joint_type)
+        posed[moving] = source[moving] @ transform[:3, :3].T + transform[:3, 3]
+    predicted = posed @ pose[:3, :3].T + pose[:3, 3]
+    return np.linalg.norm(predicted - target, axis=1).astype(np.float32)
+
+
+def reject_wrong_surface_anchors(
+    target_points_w: np.ndarray,
+    part_ids: np.ndarray,
+    *,
+    source_points_o: np.ndarray,
+    pose_world_from_object: np.ndarray,
+    theta: float,
+    axis_o: np.ndarray,
+    origin_o: np.ndarray,
+    part_surface_samples_o: np.ndarray,
+    part_surface_offsets: np.ndarray,
+    margin_external: float,
+    joint_type: str = "revolute",
+) -> dict[str, Any]:
+    """Drop anchors whose triangulated target sits on the *other* part's surface.
+
+    When the flow loses the moving part, its anchors do not scatter -- they latch
+    onto the nearest well-textured thing, which is the other part, and they track it
+    faithfully from then on. Measured on one capture: by the time the angle had
+    settled at its ceiling, 100 % of moving anchors were nearer the static part's
+    surface than their own, sitting 2.5-6.3 mm off it. That is a *coherent* error, so
+    every residual-based test is blind to it by construction -- the fit explains
+    those anchors well, it just explains them with a wrong angle. Asking which
+    surface a point is on is a different question, and it is the one that separates
+    this failure from a healthy frame.
+
+    Nothing here reads the joint type except through ``joint_transform``, so it works
+    unchanged for a prismatic joint -- but expect it to abstain far more often. The
+    abstain condition asks whether the two surfaces are separated at all where the
+    anchor lives, and a part that slides inside its housing keeps them in contact
+    along its whole travel. Silence from this test on a sliding joint means it had no
+    information, not that the frame was healthy.
+
+    The two surfaces come from the current estimate, which is circular in principle.
+    It is not in practice: the static part's anchors stay accurate (about 1 mm)
+    through the whole failure, so the pose used for the test is right even while the
+    angle is wrong. That asymmetry is what makes the test possible.
+
+    Rejection needs a wrong answer, a clearly better one, and a question worth
+    asking. An anchor is dropped only if it is off its own surface by more than
+    ``margin``, another surface is closer by more than ``margin``, and the two
+    surfaces are more than ``margin`` apart *at that anchor* to begin with. The last
+    condition is what keeps a closed lid: it rests on the body, so its anchors are
+    already as near the wrong surface as they will ever be, and no amount of
+    measurement can say which one they belong to. Anchors near the hinge are kept for
+    the same reason. The test abstains where it has no information rather than
+    guessing, which is why it stays silent on healthy frames.
+    """
+    target = np.asarray(target_points_w, dtype=np.float64).reshape(-1, 3)
+    source = np.asarray(source_points_o, dtype=np.float64).reshape(-1, 3)
+    parts = np.asarray(part_ids, dtype=np.int64).reshape(-1)
+    samples = np.asarray(part_surface_samples_o, dtype=np.float64).reshape(-1, 3)
+    offsets = np.asarray(part_surface_offsets, dtype=np.int64).reshape(-1)
+    pose = _coerce_pose_matrix(pose_world_from_object).astype(np.float64)
+    margin = float(margin_external)
+
+    num_parts = int(offsets.shape[0]) - 1
+    if num_parts < 2 or target.shape[0] == 0:
+        return {"keep_mask": np.ones(target.shape[0], dtype=bool), "num_rejected": 0,
+                "num_rejected_by_part": [0] * max(num_parts, 0)}
+
+    # Everything in the object frame: each part's surface carried there by its own
+    # transform, the moving one through the joint at the angle under test. Distances
+    # are unchanged by the rigid change of frame, and doing it this way means the same
+    # two trees answer both questions below.
+    from scipy.spatial import cKDTree
+
+    joint = joint_transform(axis_o, origin_o, float(theta), joint_type=joint_type)
+    inverse_pose = np.linalg.inv(pose)
+    target_object = target @ inverse_pose[:3, :3].T + inverse_pose[:3, 3]
+    moving = parts == 1
+    source_object = source.copy()
+    if moving.any():
+        source_object[moving] = source[moving] @ joint[:3, :3].T + joint[:3, 3]
+
+    index = np.arange(target.shape[0])
+    part_index = np.clip(parts, 0, num_parts - 1)
+    distances = np.empty((target.shape[0], num_parts), dtype=np.float64)
+    separations = np.empty((target.shape[0], num_parts), dtype=np.float64)
+    for part_id in range(num_parts):
+        points_o = samples[offsets[part_id]:offsets[part_id + 1]]
+        if part_id == 1:
+            points_o = points_o @ joint[:3, :3].T + joint[:3, 3]
+        tree = cKDTree(points_o)
+        distances[:, part_id], _ = tree.query(target_object, k=1, workers=-1)
+        # Same tree, asked about the anchor's *modelled* position instead: how far
+        # apart the surfaces are where this anchor lives.
+        separations[:, part_id], _ = tree.query(source_object, k=1, workers=-1)
+
+    own = distances[index, part_index]
+    other = distances.copy()
+    other[index, part_index] = np.inf
+    nearest_other = other.min(axis=1)
+    separation = separations.copy()
+    separation[index, part_index] = np.inf
+    nearest_separation = separation.min(axis=1)
+
+    reject = ((own > margin) & (nearest_other < own - margin)
+              & (nearest_separation > margin))
+    keep_mask = ~reject
+    return {
+        "keep_mask": keep_mask,
+        "num_rejected": int(np.count_nonzero(reject)),
