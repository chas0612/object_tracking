+def sample_articulated_mesh_anchors(
+    part_mesh_paths: Sequence[str | Path],
+    num_anchors: int,
+    joint_axis_o: Sequence[float],
+    joint_origin_o: Sequence[float],
+    *,
+    mesh_scale: float = 1.0,
+    method: str = "fps",
+    seed: int = 0,
+    part_names: Sequence[str] | None = None,
+    theta_limits_rad: Sequence[float] | None = None,
+    joint_type: str = "revolute",
+    joint_limits: Sequence[float] | None = None,
+    **sample_kwargs: Any,
+) -> dict[str, Any]:
+    """An anchor bank over two or more rigid parts joined by one joint.
+
+    Each part is sampled on its own and the banks are concatenated, so every anchor
+    carries the ``part_ids`` label the articulated fit needs. Part 0 is the static
+    body and part 1 is the one on the far side of the joint; the ordering of
+    ``part_mesh_paths`` is what defines that, and it is not inferred.
+
+    The anchor budget is split by surface area rather than evenly. A lid with a
+    third of the body's area would otherwise be sampled three times as densely,
+    which quietly reweights the fit toward the part that happens to be smaller --
+    and since the moving part is the only one carrying angle information, that would
+    also change how strongly the angle is determined.
+
+    ``face_indices`` and ``vertex_indices`` are offset by the running vertex and
+    face counts, so they index the parts concatenated in this order -- the same mesh
+    the renderer builds when it fuses the parts at an angle.
+
+    ``joint_type`` is ``revolute`` or ``prismatic``, and it decides which of the two
+    limit arguments applies. ``theta_limits_rad`` is radians, which are dimensionless
+    and therefore need only one copy no matter what unit system the anchors are read
+    in. ``joint_limits`` is in the joint's own unit and is what a prismatic joint
+    takes, because a displacement is a *length*: it scales with the anchors exactly
+    like ``joint_origin_o`` does, and ``prepare_anchor_bank_for_gotrack`` stores the
+    scaled copy alongside the original for the same reason it does for the origin.
+    """
+    kind = validate_joint_type(joint_type)
+    if theta_limits_rad is not None and joint_limits is not None:
+        raise ValueError("Pass theta_limits_rad or joint_limits, not both")
+    if kind == "prismatic" and theta_limits_rad is not None:
+        raise ValueError(
+            "theta_limits_rad is radians and cannot describe a prismatic joint; "
+            "use joint_limits, in the same units as the meshes")
+    paths = [Path(p).expanduser().resolve() for p in part_mesh_paths]
+    if len(paths) < 2:
+        raise ValueError("Articulated sampling needs at least two part meshes")
+    if part_names is not None and len(part_names) != len(paths):
+        raise ValueError("part_names must match part_mesh_paths")
+
+    meshes = [load_mesh(path, mesh_scale=mesh_scale) for path in paths]
+    areas = np.array([float(mesh.area) for mesh in meshes], dtype=np.float64)
+    if not np.all(areas > 0.0):
+        raise ValueError("Every part mesh must have positive surface area")
+
+    # Largest-remainder apportionment, so the parts sum to exactly num_anchors and
+    # no part is rounded away to nothing.
+    exact = areas / areas.sum() * float(num_anchors)
+    counts = np.floor(exact).astype(int)
+    counts = np.maximum(counts, 1)
+    while counts.sum() > int(num_anchors) and counts.max() > 1:
+        counts[int(np.argmax(counts))] -= 1
+    for index in np.argsort(-(exact - np.floor(exact)))[: max(0, int(num_anchors) - counts.sum())]:
+        counts[int(index)] += 1
+
+    banks, part_ids = [], []
+    vertex_offset = 0
+    for part_id, (path, mesh, count) in enumerate(zip(paths, meshes, counts)):
+        bank = sample_mesh_anchors(
+            path, int(count), mesh_scale=mesh_scale, method=method,
+            seed=int(seed) + part_id, **sample_kwargs)
+        face_offset = sum(int(np.asarray(m.faces).shape[0]) for m in meshes[:part_id])
+        bank["face_indices"] = bank["face_indices"] + face_offset
+        bank["vertex_indices"] = bank["vertex_indices"] + vertex_offset
+        vertex_offset += int(np.asarray(mesh.vertices).shape[0])
+        banks.append(bank)
+        part_ids.append(np.full(int(bank["positions_o"].shape[0]), part_id, dtype=np.int64))
+
+    axis = np.asarray(joint_axis_o, dtype=np.float64).reshape(3)
+    axis_norm = float(np.linalg.norm(axis))
+    if axis_norm < 1.0e-12:
+        raise ValueError("joint_axis_o is degenerate")
+    axis = axis / axis_norm
+
+    merged = {
+        key: np.concatenate([bank[key] for bank in banks], axis=0)
+        for key in ("positions_o", "normals_o", "face_indices", "vertex_indices", "barycentric")
+    }
+    merged["part_ids"] = np.concatenate(part_ids, axis=0)
+
+    # A dense point cloud per part, only ever queried as "how far is this from that
+    # part's surface".  Anchors themselves are far too sparse to answer it: they sit
+    # about a centimetre apart, which is the same size as the error being measured.
+    # Sampling here rather than at fit time keeps the meshes out of the tracking
+    # loop, and keeps these points in the same frame and units as ``positions_o``.
+    surface_samples, surface_offsets = [], [0]
+    for mesh in meshes:
+        count = int(np.clip(int(mesh.area / max(areas.sum(), 1e-12) * 16000), 2000, 16000))
+        points, _ = trimesh.sample.sample_surface(mesh, count, seed=int(seed))
+        surface_samples.append(np.asarray(points, dtype=np.float32))
+        surface_offsets.append(surface_offsets[-1] + int(points.shape[0]))
+    merged["part_surface_samples_o"] = np.concatenate(surface_samples, axis=0)
+    merged["part_surface_offsets"] = np.asarray(surface_offsets, dtype=np.int64)
+
+    merged["metadata"] = {
