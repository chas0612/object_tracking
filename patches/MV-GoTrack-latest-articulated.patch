+
+    def _project(self, **kwargs):
+        joint = self.joint
+        return self._projection(**kwargs, part_ids=joint["part_ids"],
+                                joint_axis_o=joint["joint_axis_o"], joint_origin_o=joint["joint_origin_o"],
+                                theta=self.predicted, joint_type=joint["joint_type"])
+
+    def set_frame(self, index):
+        self.current_frame = int(index)
+
+    def step(self, images, K, T_c_w, prior_T_w_o):
+        self.pinned = self.current_frame in self.external_anchors
+        self.predicted = self.external_anchors[self.current_frame] if self.pinned else self.coordinate
+        if not self.pinned and self.extrapolate_max > 0 and len(self.history) == 2:
+            (f0, q0), (f1, q1) = self.history
+            if f1 != f0:
+                delta = (q1 - q0) * (self.current_frame - f1) / (f1 - f0)
+                self.predicted += float(np.clip(delta, -self.extrapolate_max, self.extrapolate_max))
+        limits = self.joint["joint_limits"]
+        if limits is not None:
+            self.predicted = float(np.clip(self.predicted, *limits))
+        kind = self.joint["joint_type"]
+        self._model.renderer.set_object_joint_angle(self._object_id, self.predicted)
+        parts = self.moving_vertices.astype(np.int64)
+        vertices = pose_anchors_at_joint_angle(self.canonical_vertices, parts, self.joint["joint_axis_o"],
+                                               self.joint["joint_origin_o"], self.predicted, joint_type=kind)
+        self._model.object_vertices_external[self._object_id] = vertices
+        self._model.object_vertices_gotrack[self._object_id] = vertices * 1000
+        self._model.object_vertices = self._model.object_vertices_gotrack
+        # A cached crop/template contains the previous geometry. The tensor-only
+        # compiled observer is retained; host preparation must rebuild per angle.
+        self._optim_state = {}
+        result = super().step(images, K, T_c_w, prior_T_w_o)
+        health = result.health
+        if result.status == "ok" and health.get("theta_observed", False):
+            self.coordinate = float(health["joint_value"])
+            if self.history and self.history[-1][0] == self.current_frame:
+                self.history[-1] = (self.current_frame, self.coordinate)
+            else:
+                self.history.append((self.current_frame, self.coordinate))
+                self.history = self.history[-2:]
+        health.update(joint_value=self.coordinate, joint_type=kind,
+                      theta_observed=bool(health.get("theta_observed", False)))
+        if kind == "revolute":
+            health.update(theta_rad=self.coordinate, theta_deg=float(np.degrees(self.coordinate)))
+        return result
