+def _dump_anchor_targets(
+    *,
+    frame_index: int,
+    refine_iter: int,
+    object_state: "ObjectRuntimeState",
+    triangulation_result: dict[str, Any],
+    fit_result: dict[str, Any],
+    out_dir: Path,
+) -> None:
+    """Write this frame's triangulated anchor targets, labelled by part.
+
+    Diagnostic only, off unless ``--dump-anchor-target-frames`` names the frame.
+    The aggregate residual statistics on the world record cannot say *where* a bad
+    anchor went, and that is the difference between an anchor that is slightly off
+    its own surface and one that has latched onto the other part.
+    """
+    records = triangulation_result.get("records") or []
+    if not records:
+        return
+    anchor_ids = np.asarray([int(record["anchor_id"]) for record in records], dtype=np.int64)
+    part_ids = np.asarray(object_state.anchor_bank.get("part_ids"), dtype=np.int64)
+    out_dir.mkdir(parents=True, exist_ok=True)
+    np.savez_compressed(
+        out_dir / f"frame_{frame_index:06d}_iter{refine_iter}.npz",
+        anchor_ids=anchor_ids,
+        part_ids=(part_ids[anchor_ids] if part_ids.size else np.zeros_like(anchor_ids)),
+        positions_o=np.asarray(triangulation_result["positions_o"], dtype=np.float32),
+        positions_w=np.asarray(triangulation_result["positions_w"], dtype=np.float32),
+        weights=np.asarray(triangulation_result["weights"], dtype=np.float32),
