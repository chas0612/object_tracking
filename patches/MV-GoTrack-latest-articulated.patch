+def fuse_articulated_parts(
+    part_mesh_paths: Sequence[str | Path],
+    *,
+    mesh_scale: float = 1.0,
+) -> tuple[trimesh.Trimesh, np.ndarray]:
+    """Concatenate the parts at zero angle, and say which vertices are the moving one.
+
+    The renderer needs one mesh, and it must be the same mesh the anchor bank's
+    ``vertex_indices`` were offset against -- parts in this order, vertices
+    concatenated, nothing reordered. Building it here rather than asking for a
+    pre-fused asset is what guarantees that: a fused mesh made elsewhere could have
+    its parts in the other order, or be welded, and the anchors would then be
+    labelled against a vertex numbering that no longer exists.
+
+    Zero angle because the joint is applied at render time, not baked in.
+    """
+    paths = [Path(p).expanduser().resolve() for p in part_mesh_paths]
+    meshes = [load_mesh(path, mesh_scale=mesh_scale) for path in paths]
+    counts = [int(np.asarray(mesh.vertices).shape[0]) for mesh in meshes]
+    fused = trimesh.util.concatenate(meshes)
+    if int(np.asarray(fused.vertices).shape[0]) != sum(counts):
+        raise ValueError(
+            "Concatenation changed the vertex count, so anchor vertex indices would "
+            "no longer line up with the fused mesh"
+        )
+    moving = np.zeros(sum(counts), dtype=bool)
+    moving[counts[0]:] = True
+    return fused, moving
