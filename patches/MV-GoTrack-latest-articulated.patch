+def test_units_round_trip() -> None:
+    """The asymmetry that makes this port dangerous, pinned in both directions.
+
+    An angle is dimensionless and is stored once. A displacement is a length and is
+    stored twice, exactly like the joint origin. Getting this wrong does not raise --
+    it puts the travel stop a thousand times too far away -- so both halves are
+    asserted here rather than left to the caller to remember.
+    """
+    print("\nunit round trip")
+    with tempfile.TemporaryDirectory() as directory:
+        housing, drawer = _write_boxes(Path(directory))
+        bank = sample_articulated_mesh_anchors(
+            [housing, drawer], num_anchors=256,
+            joint_axis_o=AXIS, joint_origin_o=BOGUS_ORIGIN,
+            part_names=["housing", "drawer"],
+            joint_type="prismatic", joint_limits=TRAVEL, seed=0)
+        _check("joint type recorded", bank["metadata"]["joint_type"] == "prismatic")
+        _check("no radian limits invented",
+               bank["metadata"]["theta_limits_rad"] is None)
+
+        prepared = prepare_anchor_bank_for_gotrack(
+            bank, translation_scale_to_gotrack=1000.0)
+        external = articulation_from_anchor_bank(prepared, units="external")
+        gotrack = articulation_from_anchor_bank(prepared, units="gotrack")
+        _check("external travel unchanged",
+               np.allclose(external["joint_limits"], TRAVEL),
+               f"{external['joint_limits']}")
+        _check("gotrack travel scaled by 1000",
+               np.allclose(gotrack["joint_limits"], np.asarray(TRAVEL) * 1000.0),
+               f"{gotrack['joint_limits']}")
+        _check("axis is a direction and does not scale",
+               np.allclose(external["joint_axis_o"], gotrack["joint_axis_o"]))
+        _check("type survives both unit systems",
+               external["joint_type"] == gotrack["joint_type"] == "prismatic")
+
+        saved = Path(directory) / "bank.npz"
+        save_anchor_bank(saved, prepared)
+        reloaded = articulation_from_anchor_bank(load_anchor_bank(saved), units="gotrack")
+        _check("and survives a save/load round trip",
+               np.allclose(reloaded["joint_limits"], np.asarray(TRAVEL) * 1000.0)
+               and reloaded["joint_type"] == "prismatic")
+
+        # The other half of the asymmetry: a hinge's limits are radians, so the two
+        # unit systems must report the *same* numbers. A future edit that "fixes" the
+        # units by scaling all limits uniformly breaks here.
+        hinge = prepare_anchor_bank_for_gotrack(
+            sample_articulated_mesh_anchors(
+                [housing, drawer], num_anchors=256,
+                joint_axis_o=AXIS, joint_origin_o=BOGUS_ORIGIN,
+                part_names=["housing", "drawer"],
+                theta_limits_rad=(0.0, 3.6), seed=0),
+            translation_scale_to_gotrack=1000.0)
+        hinge_external = articulation_from_anchor_bank(hinge, units="external")
+        hinge_gotrack = articulation_from_anchor_bank(hinge, units="gotrack")
+        _check("radian limits are identical in both unit systems",
+               np.allclose(hinge_external["joint_limits"], hinge_gotrack["joint_limits"])
+               and np.allclose(hinge_gotrack["joint_limits"], (0.0, 3.6)),
+               f"{hinge_gotrack['joint_limits']}")
+        _check("but the hinge origin does scale",
+               np.allclose(hinge_gotrack["joint_origin_o"],
+                           hinge_external["joint_origin_o"] * 1000.0))
+
+
+def test_legacy_bank_reads_as_revolute() -> None:
+    """A bank written before joint types existed must keep working untouched."""
+    print("\nlegacy bank")
+    with tempfile.TemporaryDirectory() as directory:
+        housing, drawer = _write_boxes(Path(directory))
+        bank = sample_articulated_mesh_anchors(
+            [housing, drawer], num_anchors=256,
+            joint_axis_o=AXIS, joint_origin_o=BOGUS_ORIGIN,
+            part_names=["housing", "drawer"], theta_limits_rad=(0.0, 3.6), seed=0)
+        del bank["metadata"]["joint_type"]
+        articulation = articulation_from_anchor_bank(bank, units="external")
+        _check("defaults to revolute", articulation["joint_type"] == "revolute")
+        _check("radian limits still surface",
+               np.allclose(articulation["theta_limits_rad"], (0.0, 3.6)))
+        _check("and appear under the neutral name too",
+               np.allclose(articulation["joint_limits"], (0.0, 3.6)))
+
+
+def test_every_joint_call_declares_its_type() -> None:
+    """No production call to a joint-aware function may rely on the default.
+
+    The joint type reaches the geometry by being passed down by hand through every
+    call site, and a missed one does not raise -- it silently treats a slide as a
+    hinge, which was exactly the bug this file's own development produced: one of
+    four residual calls kept the default, the moving anchors then looked 66 mm out of
+    place, and the run reported a healthy-looking ``theta_rejected`` instead of an
+    error. A grep is the only thing that catches that class of omission, so it is a
+    test.
+
+    Tests are exempt: several of them call without the argument precisely to check
+    that the default is still revolute.
+    """
+    print("\njoint type threading")
+    import ast
+
+    names = {"joint_transform", "compute_articulated_fit_residuals",
+             "reject_wrong_surface_anchors", "robust_fit_articulated_pose_from_anchors",
+             "fit_articulated_transform_weighted", "pose_anchors_at_joint_angle",
+             "set_object_joint"}
+    root = Path(__file__).resolve().parents[1]
+    missing: list[str] = []
+    scanned = 0
+    for directory in ("utils", "archive", "evaluation"):
+        for path in sorted((root / directory).rglob("*.py")):
+            scanned += 1
+            for node in ast.walk(ast.parse(path.read_text(encoding="utf-8"))):
+                if not isinstance(node, ast.Call):
+                    continue
+                function = node.func
+                name = (function.attr if isinstance(function, ast.Attribute)
+                        else getattr(function, "id", None))
+                if name in names and not any(
+                        keyword.arg == "joint_type" for keyword in node.keywords):
+                    missing.append(f"{path.relative_to(root)}:{node.lineno} {name}")
+    _check("every production call passes joint_type", not missing,
+           f"{scanned} files scanned" if not missing else "; ".join(missing))
+
+
+if __name__ == "__main__":
+    test_transform_is_a_pure_translation()
+    test_displacement_alone()
+    test_exact()
+    test_displacement_is_never_wrapped()
+    test_far_displacement_needs_a_nearby_start()
+    test_noise()
+    test_limit_mixups_are_errors()
+    test_record_omits_angle_keys()
+    test_clamp_uses_joint_limits()
+    test_units_round_trip()
+    test_legacy_bank_reads_as_revolute()
+    test_every_joint_call_declares_its_type()
+    print(f"\n{len(FAILURES)} failures" + (f": {FAILURES}" if FAILURES else ""))
+    raise SystemExit(1 if FAILURES else 0)
