+        # one that is always written; the angle stays for readers that predate it.
+        theta_rad=np.float32(fit_result.get("theta_rad", np.nan)),
+        joint_value=np.float32(fit_result.get("joint_value", np.nan)),
+        pose_world_from_object=np.asarray(
+            fit_result.get("pose_world_from_object", np.full((4, 4), np.nan)),
+            dtype=np.float64),
+    )
