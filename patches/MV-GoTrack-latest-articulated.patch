+        self.deploy_manifest = self._build_deploy_manifest(self._args, self._model, self._graph)
+        self.deploy_manifest["articulation"] = dict(spec=spec, num_anchors=len(bank["positions_o"]),
+                                                  anchor_sampler=bank["metadata"].get("method", "articulated_fps"),
+                                                  fit="alternating_articulated_trifit",
+                                                  joint_units="m" if kind == "prismatic" else "rad")
+        # The parent manifest describes a rigid producer bank and a torch rigid
+        # solver; these have both been replaced by the live one-joint objects.
+        fields = self.deploy_manifest["fields"]
+        fields["anchor_sampler"] = "per_part_area_budget_runner_fps_os8_seed0"
+        fields["solver_precision"] = "numpy_float64"
+        fields["classical_gate"]["solver"] = "alternating_articulated_trifit"
+        fields["articulation"] = self.deploy_manifest["articulation"]
+        self.deploy_manifest["info"]["solver_exec"] = dict(impl="numpy", dtype="float64", mode="alternating")
+        self.deploy_manifest["info"]["mesh"] = "ordered joint parts (metres), posed each frame"
