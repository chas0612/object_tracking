+        # body around it, which is the rigid problem with the moving part pre-swung.
+        swung = source[selected].copy()
+        moving_local = parts[selected] == 1
+        if moving_local.any():
+            transform = joint_transform(axis_o, origin_o, float(theta_init), joint_type=kind)
+            swung[moving_local] = (source[selected][moving_local] @ transform[:3, :3].T
