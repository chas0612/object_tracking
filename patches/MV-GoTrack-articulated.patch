+def _predict_theta(object_state: "ObjectRuntimeState", max_step_rad: float) -> float:
+    """The angle to project and render at this frame.
+
+    Linear extrapolation from the last two measurements, capped. Capped because the
+    cost of the two errors is not symmetric: predicting slightly short leaves the
+    flow the same small lag it already had, while predicting wildly long puts the
+    template somewhere the object never was and loses the anchors outright.
+    """
+    if max_step_rad <= 0.0 or object_state.theta_last_frame is None:
+        return float(object_state.theta)
+    step = float(object_state.theta) - float(object_state.theta_last_frame)
+    step = float(np.clip(step, -max_step_rad, max_step_rad))
+    return float(object_state.theta) + step
+
