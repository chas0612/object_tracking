+        # tiny numbers. It reuses the inlier tolerance rather than adding a constant.
+        if moving_median > max(theta_residual_ratio * static_median,
+                               0.5 * inlier_threshold_external):
+            theta_rejected = True
+            theta_observed = False
+            pose_initial, theta_initial, rounds = _fit(None)
+            residuals_initial = compute_articulated_fit_residuals(
+                pose_initial, theta_initial, source, target, parts, axis_o, origin_o,
+                joint_type=kind)
+    inlier_mask = residuals_initial <= inlier_threshold_external
+
+    enough_inliers = int(np.count_nonzero(inlier_mask)) >= max(int(min_anchors), 3)
+    # Refitting on inliers that happen to exclude the moving part would silently turn
+    # an articulated fit into a rigid one at the previous angle, so keep the first
+    # fit unless the inliers still see the joint.
+    keeps_joint = (not theta_observed) or int(
+        np.count_nonzero(inlier_mask & (parts == 1))) >= max(int(min_moving_anchors), 1)
+    if enough_inliers and keeps_joint:
+        pose_final, theta_final, rounds = _fit(inlier_mask)
+        residuals_final = compute_articulated_fit_residuals(
+            pose_final, theta_final, source, target, parts, axis_o, origin_o,
+            joint_type=kind)
+        status = ("ok" if theta_observed
+                  else "theta_rejected" if theta_rejected else "theta_unobserved")
+    else:
+        pose_final, theta_final = pose_initial, theta_initial
+        residuals_final = residuals_initial
+        status = ("no_inlier_refit" if theta_observed
+                  else "theta_rejected" if theta_rejected else "theta_unobserved")
+
+    theta_clamped = False
+    if limits is not None:
+        lower, upper = (float(limits[0]), float(limits[1]))
+        limited = float(np.clip(theta_final, lower, upper))
+        theta_clamped = not np.isclose(limited, theta_final)
+        if theta_clamped:
+            theta_final = limited
+            residuals_final = compute_articulated_fit_residuals(
+                pose_final, theta_final, source, target, parts, axis_o, origin_o,
+                joint_type=kind)
+
+    residuals_m = residuals_final * unit_scale_to_meter
+    record = {
+        "status": status,
+        "pose_world_from_object": pose_final.astype(np.float32),
+        # The joint coordinate under a type-neutral name, always present. For a
+        # revolute joint the two angle keys below carry the same number and stay for
+        # the readers that predate this; a prismatic joint has neither.
+        "joint_type": kind,
+        "joint_value": float(theta_final),
+        "theta_observed": bool(theta_observed),
+        "theta_clamped": bool(theta_clamped),
+        "theta_rejected": bool(theta_rejected),
+        "theta_residual_ratio": float(residual_ratio),
+        "residuals_external_units": residuals_final.astype(np.float32),
+        "residuals_m": residuals_m.astype(np.float32),
+        "residuals_mm": (residuals_m * 1000.0).astype(np.float32),
+        "inlier_mask": inlier_mask.astype(bool),
+        "num_input_anchors": int(source.shape[0]),
+        "num_inlier_anchors": int(np.count_nonzero(inlier_mask)),
+        "num_moving_anchors": moving_count,
+        "num_rounds": int(rounds),
+        "mean_residual_mm": float(np.mean(residuals_m) * 1000.0),
+        "max_residual_mm": float(np.max(residuals_m) * 1000.0),
+    }
+    if kind == "revolute":
+        record["theta_rad"] = float(theta_final)
+        record["theta_deg"] = float(np.degrees(theta_final))
+    return record
