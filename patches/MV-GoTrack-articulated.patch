@@ -0,0 +1,166 @@
+#!/usr/bin/env python3
+"""Exercise the runtime's articulated path without a GPU, a model, or a capture.
+
+The tracker's real loop needs cameras, checkpoints and images. The wiring it grew
+does not: what was added is a joint travelling from an anchor bank into the
+projection and the fit, an angle carried between frames, and a per-frame record
+that says whether the angle was measured or merely held. All of that is decidable
+from arrays.
+
+The failure this is really guarding against is the joint arriving in the wrong
+units or the anchors being swung twice -- neither raises, both quietly return an
+angle that means nothing.
+
+Run: python tests/test_articulated_runtime_wiring.py
+"""
+
+from __future__ import annotations
+
+import json
+import sys
+import tempfile
+from pathlib import Path
+
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from utils.anchor_bank import (  # noqa: E402
+    articulation_from_anchor_bank,
+    load_anchor_bank,
+    prepare_anchor_bank_for_gotrack,
+    sample_articulated_mesh_anchors,
+    sample_mesh_anchors,
+    save_anchor_bank,
+)
+from utils.anchor_tracking import pose_anchors_at_joint_angle  # noqa: E402
+from utils.multiview_geometry import (  # noqa: E402
+    joint_transform,
+    robust_fit_articulated_pose_from_anchors,
+)
+
+PARTS = Path.home() / "shared_data/mesh_new/blue_plastic_box/articulation_particulate"
+FAILURES: list[str] = []
+
+
+def _check(name: str, condition: bool, detail: str = "") -> None:
+    print(f"  {'PASS' if condition else 'FAIL'}  {name}{'  ' + detail if detail else ''}")
+    if not condition:
+        FAILURES.append(name)
+
+
+def main() -> int:
+    joint = json.loads((PARTS / "joint.json").read_text(encoding="utf-8"))["measured"]
+    axis = np.asarray(joint["axis"], dtype=np.float64)
+    origin = np.asarray(joint["origin"], dtype=np.float64)
+    limits = tuple(float(v) for v in joint["range_rad"])
+
+    bank = sample_articulated_mesh_anchors(
+        [PARTS / "parts/body.obj", PARTS / "parts/lid.obj"], num_anchors=384,
+        joint_axis_o=axis, joint_origin_o=origin,
+        part_names=["body", "lid"], theta_limits_rad=limits, seed=0)
+    bank = prepare_anchor_bank_for_gotrack(bank, translation_scale_to_gotrack=1000.0)
+
+    print("\nthe joint the runtime will read")
+    articulation = articulation_from_anchor_bank(bank, units="external")
+    _check("bank reports itself articulated", articulation is not None)
+    _check("external origin is the mesh's own",
+           np.allclose(articulation["joint_origin_o"], origin),
+           f"{articulation['joint_origin_o'].round(4).tolist()}")
+    gotrack = articulation_from_anchor_bank(bank, units="gotrack")
+    _check("gotrack origin is scaled, axis is not",
+           np.allclose(gotrack["joint_origin_o"], origin * 1000.0)
+           and np.allclose(gotrack["joint_axis_o"], articulation["joint_axis_o"]))
+    _check("limits travel with it", articulation["theta_limits_rad"] == limits)
+
+    print("\na rigid bank stays on the old path")
+    rigid = sample_mesh_anchors(PARTS / "parts/body.obj", 64, seed=0)
+    _check("rigid bank reports no joint", articulation_from_anchor_bank(rigid) is None)
+
+    print("\nswinging is not applied twice")
+    source = bank["positions_o"].astype(np.float64)
+    parts = bank["part_ids"]
+    theta = np.radians(120.0)
+    once = pose_anchors_at_joint_angle(source, parts, axis, origin, theta)
+    twice = pose_anchors_at_joint_angle(once, parts, axis, origin, theta)
+    direct = pose_anchors_at_joint_angle(source, parts, axis, origin, 2.0 * theta)
+    _check("posing twice equals posing by twice the angle",
+           np.allclose(twice, direct, atol=1e-5))
+    _check("and differs from posing once",
+           float(np.max(np.abs(twice - once))) > 0.01,
+           f"max {float(np.max(np.abs(twice - once))):.3f} m apart")
+    _check("static part never moves",
+           np.allclose(once[parts == 0], source[parts == 0], atol=1e-6))
+
+    print("\nangle carried across a frame series")
+    # Anchors are always canonical; each frame swings them by its own angle, which
+    # is what the runtime does through project_anchors_to_view.
+    pose_true = np.eye(4)
+    pose_true[:3, 3] = [0.4, -0.1, 0.25]
+    rng = np.random.default_rng(0)
+    carried = 0.0
+    recovered = []
+    for theta_true_deg in (0.0, 12.7, 47.4, 92.8, 163.6, 196.7, 215.0):
+        posed = pose_anchors_at_joint_angle(
+            source, parts, axis, origin, np.radians(theta_true_deg)).astype(np.float64)
+        target = posed @ pose_true[:3, :3].T + pose_true[:3, 3]
+        target += rng.normal(scale=0.003, size=target.shape)
+        result = robust_fit_articulated_pose_from_anchors(
+            source, target, np.ones(len(source)), parts, axis, origin,
+            inlier_threshold_mm=15.0, theta_init=carried,
+            theta_reference_rad=carried, theta_limits_rad=None)
+        carried = float(result["theta_rad"])   # what the runtime writes back
+        recovered.append(result["theta_deg"])
+        _check(f"frame at {theta_true_deg:6.1f} deg",
+               abs(result["theta_deg"] - theta_true_deg) < 1.0 and result["theta_observed"],
+               f"got {result['theta_deg']:7.2f} deg")
+    _check("series never wraps negative past 180 deg",
+           all(value > -1.0 for value in recovered),
+           f"min {min(recovered):.2f} deg, max {max(recovered):.2f} deg")
+
+    print("\nmoving part occluded away")
+    visible = parts == 0
+    posed = pose_anchors_at_joint_angle(
+        source, parts, axis, origin, np.radians(163.6)).astype(np.float64)
+    target = posed @ pose_true[:3, :3].T + pose_true[:3, 3]
+    held = np.radians(163.6)
+    result = robust_fit_articulated_pose_from_anchors(
+        source[visible], target[visible], np.ones(int(visible.sum())), parts[visible],
+        axis, origin, inlier_threshold_mm=15.0, theta_init=held, theta_reference_rad=held)
+    _check("angle is flagged unobserved", not result["theta_observed"]
+           and result["status"] == "theta_unobserved")
+    _check("held angle comes back unchanged", abs(result["theta_rad"] - held) < 1e-9)
+    shift = np.linalg.norm(
+        result["pose_world_from_object"][:3, 3] - pose_true[:3, 3]) * 1000.0
+    _check("body pose still solved", shift < 1.0, f"{shift:.3f} mm")
+
+    print("\nbank round trip through disk, as the runtime loads it")
+    with tempfile.TemporaryDirectory() as tmp:
+        path = Path(tmp) / "bank.npz"
+        save_anchor_bank(path, bank)
+        reloaded = articulation_from_anchor_bank(load_anchor_bank(path), units="external")
+    _check("joint survives", np.allclose(reloaded["joint_axis_o"], articulation["joint_axis_o"])
+           and np.allclose(reloaded["joint_origin_o"], articulation["joint_origin_o"])
+           and np.array_equal(reloaded["part_ids"], articulation["part_ids"]))
+
+    print("\nwrong units are visibly wrong, not silently wrong")
+    # If someone hands the fit the GoTrack-scaled origin while the anchors are in
+    # metres, the hinge sits a thousand times too far away. The point of this check
+    # is that such a mistake produces a bad angle rather than a plausible one.
+    posed = pose_anchors_at_joint_angle(
+        source, parts, axis, origin, np.radians(90.0)).astype(np.float64)
+    target = posed @ pose_true[:3, :3].T + pose_true[:3, 3]
+    wrong = robust_fit_articulated_pose_from_anchors(
+        source, target, np.ones(len(source)), parts, axis, origin * 1000.0,
+        inlier_threshold_mm=15.0)
+    _check("mismatched origin units give a large residual",
+           wrong["mean_residual_mm"] > 10.0,
+           f"mean residual {wrong['mean_residual_mm']:.1f} mm, "
+           f"theta {wrong['theta_deg']:.1f} deg")
+
+    print(f"\n{len(FAILURES)} failures" + (f": {FAILURES}" if FAILURES else ""))
+    return 1 if FAILURES else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
